generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────
// ÉNUMÉRATIONS
// ─────────────────────────────────────────────

enum Region {
  Dakar
  Thies
  Diourbel
  Fatick
  Kaolack
  Kaffrine
  Louga
  Saint_Louis
  Matam
  Tambacounda
  Kedougou
  Kolda
  Ziguinchor
  Sedhiou

  @@map("region")
}

enum Genre {
  M
  F

  @@map("genre")
}

enum StatutCompte {
  actif
  inactif
  anonymise

  @@map("statut_compte")
}

enum TypeOpportunite {
  Emploi
  Stage
  Formation
  Bourse
  Volontariat
  Appel_a_projets

  @@map("type_opportunite")
}

/// Type de contrat employé sur OpportuniteEmploi (GUIC-183 / 178b).
enum TypeContrat {
  CDI
  CDD
  FREELANCE
  ALTERNANCE
  STAGE_ALTERNE

  @@map("type_contrat")
}

/// Modalité pédagogique sur OpportuniteFormation (GUIC-183 / 178b).
enum ModaliteFormation {
  PRESENTIEL
  DISTANCE
  HYBRIDE

  @@map("modalite_formation")
}

/// Niveau d'études minimum requis (GUIC-183 / 178b).
/// Décision Q8 spec §18 : enum strict (override DP6 String libre).
enum NiveauEtudes {
  BFEM
  BAC
  BAC_PLUS_2
  BAC_PLUS_3
  BAC_PLUS_5
  DOCTORAT

  @@map("niveau_etudes")
}

/// Type de financement (GUIC-183 / 178b post-audit — spec §19).
enum TypeFinancement {
  MICROCREDIT
  SUBVENTION
  DOTATION
  PRET_HONNEUR
  CAPITAL_AMORCAGE

  @@map("type_financement")
}

/// Modalité de mentorat (GUIC-183 / 178b post-audit — spec §19).
enum ModaliteMentorat {
  INDIVIDUEL
  GROUPE
  COHORTE

  @@map("modalite_mentorat")
}

/// Type de mobilité (GUIC-183 / 178b post-audit — spec §19).
enum TypeMobilite {
  ETUDE
  STAGE
  PROFESSIONNELLE
  RECHERCHE

  @@map("type_mobilite")
}

/// Type de volontariat (GUIC-183 / 178b post-audit — spec §19).
enum TypeVolontariat {
  SERVICE_CIVIQUE
  ENGAGEMENT
  INTERNATIONAL
  HUMANITAIRE

  @@map("type_volontariat")
}

enum Domaine {
  Agriculture
  Numerique
  Entrepreneuriat
  Citoyennete
  Environnement
  Sante
  Education
  Culture
  Autre

  @@map("domaine")
}

enum StatutOpportunite {
  brouillon
  publiee
  archivee
  expiree

  @@map("statut_opportunite")
}

enum StatutCandidature {
  En_attente
  Vue
  Retenue
  Refusee

  @@map("statut_candidature")
}

enum TypeEvenement {
  Formation
  Atelier
  Forum
  Webinar
  Conference

  @@map("type_evenement")
}

enum StatutEvenement {
  a_venir
  en_cours
  termine
  annule

  @@map("statut_evenement")
}

enum TypeRessource {
  PDF
  Video
  Lien
  Guide
  Outil

  @@map("type_ressource")
}

// GUIC-24 — niveau de difficulté pour filtrer la bibliothèque.
enum NiveauRessource {
  Debutant
  Intermediaire
  Avance

  @@map("niveau_ressource")
}

// GUIC-24 — langue de la ressource (étendre si besoin).
enum LangueRessource {
  FR
  Wolof

  @@map("langue_ressource")
}

enum StatutInscription {
  inscrit
  liste_attente
  annule
  present

  @@map("statut_inscription")
}

enum RoleAgent {
  conseiller
  directeur
  admin_centre

  @@map("role_agent")
}

/// Types de notifications (M11 — GUIC-247).
enum TypeNotification {
  Deadline
  Candidature
  Message
  Yaye
  System

  @@map("type_notification")
}

// ─────────────────────────────────────────────
// M1 — SOCLE : UTILISATEURS & PROFILS
// ─────────────────────────────────────────────

// Identité de base — synchronisée depuis le SSO via webhook user.*
// Ne jamais modifier directement : la source de vérité est le SSO CJS
model Utilisateur {
  cjsUid             String       @id @map("cjs_uid") @db.VarChar(36)
  telephone          String?      @unique @db.VarChar(20)
  email              String?      @unique @db.VarChar(255)
  nom                String       @db.VarChar(100)
  prenom             String       @db.VarChar(100)
  region             Region?
  genre              Genre?
  dateNaissance      DateTime?    @map("date_naissance")
  statut             StatutCompte @default(actif)
  // Rôle principal mis en cache depuis le SSO (source de vérité = SSO ; synchronisé au login).
  role               String?      @db.VarChar(40)
  commune            String?      @db.VarChar(100)
  onboardingComplete Boolean      @default(false) @map("onboarding_complete")
  drupalUid          Int?         @unique @map("drupal_uid")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")

  profil                ProfilJeune?
  candidatures          Candidature[]
  candidatureDrafts     CandidatureDraft[]
  inscriptions          InscriptionEvenement[]
  ressourcesFavoris     RessourceFavorite[]
  opportunitesFavorites OpportuniteFavorite[]
  conversations         ConversationWhatsApp[]
  recommandations       RecommandationIA[]
  notifications         Notification[]
  // Lot 7 — Centres CJS (GUIC-350)
  reservations          Reservation[]
  checkIns              CheckIn[]
  // M8 admin (GUIC-469) — suivi des insertions professionnelles
  insertions            Insertion[]
  // Lot 3 — Bibliothèque physique (GUIC-274)
  emprunts              Emprunt[]

  @@index([email])
  @@index([telephone])
  @@index([statut])
  @@index([role])
  @@map("utilisateurs")
}

// Profil enrichi — rempli par le jeune après inscription
model ProfilJeune {
  id                String    @id @default(uuid()) @db.VarChar(36)
  cjsUid            String    @unique @map("cjs_uid") @db.VarChar(36)
  photoUrl          String?   @map("photo_url") @db.VarChar(500)
  biographie        String?   @db.Text
  // JSON arrays stockés en texte — ex: ["JavaScript","Python"] ou ["Agriculture","Numérique"]
  competences       Json?
  domainesInteret   Json?     @map("domaines_interet")
  niveauEtude       String?   @map("niveau_etude") @db.VarChar(50)
  situationEmploi   String?   @map("situation_emploi") @db.VarChar(50)
  // Score 0–100 calculé et mis à jour dans ProfilService.recalculerScore()
  completionScore   Int       @default(0) @map("completion_score")
  profileVisibility String    @default("public") @map("profile_visibility") @db.VarChar(20)
  // CV stocké (GUIC-223 / GUIC-224) — réutilisable depuis CandidatureModal
  cvUrl             String?   @map("cv_url") @db.VarChar(500)
  cvUploadedAt      DateTime? @map("cv_uploaded_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Lot 7 — Centre de rattachement principal (GUIC-350, ADR centre principal hybride)
  // Renseigné à l'onboarding via auto-suggest par région SSO, modifiable ensuite.
  centrePrincipalId String? @map("centre_principal_id") @db.VarChar(36)

  utilisateur     Utilisateur        @relation(fields: [cjsUid], references: [cjsUid])
  experiences     Experience[]
  diplomes        Diplome[]
  certificats     CertificatMoodle[]
  centrePrincipal Centre?            @relation("ProfilCentrePrincipal", fields: [centrePrincipalId], references: [id])

  @@index([centrePrincipalId])
  @@map("profils_jeunes")
}

// Expériences professionnelles du jeune
model Experience {
  id           String    @id @default(uuid()) @db.VarChar(36)
  profilId     String    @map("profil_id") @db.VarChar(36)
  poste        String    @db.VarChar(150)
  organisation String    @db.VarChar(150)
  dateDebut    DateTime  @map("date_debut")
  dateFin      DateTime? @map("date_fin")
  description  String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  profil ProfilJeune @relation(fields: [profilId], references: [id], onDelete: Cascade)

  @@index([profilId])
  @@map("experiences")
}

// Diplômes du jeune (GUIC-19) — remplace l'ancienne colonne Json `diplomes`
model Diplome {
  id             String   @id @default(uuid()) @db.VarChar(36)
  profilId       String   @map("profil_id") @db.VarChar(36)
  intitule       String   @db.VarChar(200)
  etablissement  String   @db.VarChar(200)
  anneeObtention Int      @map("annee_obtention")
  niveau         String   @db.VarChar(50)
  mention        String?  @db.VarChar(50)
  // GUIC-360 — scan justificatif (PDF/JPG/PNG) uploadé sur Vercel Blob.
  fichierUrl     String?  @map("fichier_url") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  profil ProfilJeune @relation(fields: [profilId], references: [id], onDelete: Cascade)

  @@index([profilId])
  @@map("diplomes")
}

// ─────────────────────────────────────────────
// M2 — ORGANISATION RECRUTEUR
// ─────────────────────────────────────────────

model Organisation {
  id         String   @id @default(uuid()) @db.VarChar(36)
  cjsUid     String   @map("cjs_uid") @db.VarChar(36)
  nom        String   @db.VarChar(200)
  secteur    Domaine?
  region     Region?
  adresse    String?  @db.VarChar(300)
  telephone  String?  @db.VarChar(20)
  email      String?  @db.VarChar(255)
  siteWeb    String?  @map("site_web") @db.VarChar(500)
  logoUrl    String?  @map("logo_url") @db.VarChar(500)
  estVerifie Boolean  @default(false) @map("est_verifie")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  opportunites Opportunite[]

  @@index([cjsUid])
  @@map("organisations")
}

// ─────────────────────────────────────────────
// M3 — OPPORTUNITÉS & CANDIDATURES
// ─────────────────────────────────────────────

/// Table mère M3 v2 (CTI). Colonnes legacy (type, organisation) conservées
/// pendant la migration data — supprimées en 178d après backfill.
/// Les colonnes polymorphiques (typeId, programmeId, organisationId déjà présent,
/// organisationLibelle, niveauEtudeMin) sont ajoutées en NULL dans cette étape (178b)
/// pour ne pas casser les rows existantes ; elles passent NOT NULL en 178d.
/// L'invariant XOR (1 et 1 seul sous-type non null) est garanti côté applicatif
/// via OpportuniteService — cf. spec §8.4 et `opportunite-integrity.ts`.
model Opportunite {
  id          String @id @default(uuid()) @db.VarChar(36)
  drupalNid   Int?   @unique @map("drupal_nid")
  slug        String @unique @db.VarChar(280)
  titre       String @db.VarChar(255)
  description String @db.LongText

  // Sections structurées (GUIC-257) — affichage avec h2 + paragraphes.
  // Nullable : rétro-compatible, fallback sur description plate si absentes.
  profilRecherche String? @map("profil_recherche") @db.Text
  mission         String? @db.Text
  conditions      String? @db.Text

  // Champs legacy — conservés jusqu'en 178d (drop après backfill)
  type         TypeOpportunite
  organisation String          @db.VarChar(200)

  // Nouveaux champs polymorphiques (nullable durant migration data — 178b/c)
  typeId              String?       @map("type_id") @db.VarChar(36)
  programmeId         String?       @map("programme_id") @db.VarChar(36)
  organisationLibelle String?       @map("organisation_libelle") @db.VarChar(200)
  niveauEtudeMin      NiveauEtudes? @map("niveau_etude_min")

  domaine        Domaine
  region         Region?
  organisationId String?           @map("organisation_id") @db.VarChar(36)
  remuneration   String?           @db.VarChar(100)
  deadline       DateTime?
  lienExterne    String?           @map("lien_externe") @db.VarChar(500)
  statut         StatutOpportunite @default(brouillon)
  recruteurUid   String?           @map("recruteur_uid") @db.VarChar(36)
  vues           Int               @default(0)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  org       Organisation?    @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  typeRef   OpportuniteType? @relation(fields: [typeId], references: [id])
  programme Programme?       @relation(fields: [programmeId], references: [id], onDelete: SetNull)

  // Sous-types 1:1 (un seul des dix non-null — invariant applicatif)
  // Spec §19 — 4 sous-types ajoutés post-audit guichetjeunesse.sn (2026-06-01)
  emploi        OpportuniteEmploi?
  stage         OpportuniteStage?
  formation     OpportuniteFormation?
  bourse        OpportuniteBourse?
  concours      OpportuniteConcours?
  appelAProjets OpportuniteAppelAProjets?
  financement   OpportuniteFinancement?
  mentorat      OpportuniteMentorat?
  mobilite      OpportuniteMobilite?
  volontariat   OpportuniteVolontariat?

  skills       OpportuniteSkill[]
  tags         OpportuniteTag[]
  candidatures Candidature[]
  drafts       CandidatureDraft[]
  favoris      OpportuniteFavorite[]

  @@index([statut, deletedAt])
  @@index([type, domaine])
  @@index([typeId, domaine])
  @@index([programmeId])
  @@index([region])
  @@index([deadline])
  @@fulltext([titre, description])
  @@map("opportunites")
}

model Candidature {
  id                   String            @id @default(uuid()) @db.VarChar(36)
  cjsUid               String            @map("cjs_uid") @db.VarChar(36)
  opportuniteId        String            @map("opportunite_id") @db.VarChar(36)
  statut               StatutCandidature @default(En_attente)
  lettreMotivation     String?           @map("lettre_motivation") @db.Text
  cvUrl                String?           @map("cv_url") @db.VarChar(500)
  // GUIC-361 — snapshot des données saisies au moment de la candidature
  // (email, téléphone, niveau d'études, situation, compétences…). Permet de
  // figer ce qui a été transmis au recruteur, indépendamment des évolutions
  // ultérieures du profil.
  formulaireData       Json?             @map("formulaire_data")
  notificationsConsent Boolean           @default(false) @map("notifications_consent")
  // Traçabilité du consentement CGU (GUIC-218 / audit CDP).
  consentAt            DateTime?         @map("consent_at")
  cguVersion           String?           @map("cgu_version") @db.VarChar(20)
  consentIp            String?           @map("consent_ip") @db.VarChar(45)
  soumiseA             DateTime          @default(now()) @map("soumise_a")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid], onDelete: Cascade)
  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@unique([cjsUid, opportuniteId])
  @@index([statut])
  @@index([opportuniteId])
  @@map("candidatures")
}

/**
 * Brouillon de candidature — GUIC-382 V2.
 * Permet au jeune de quitter le formulaire en cours et de le reprendre depuis
 * un autre appareil. Auto-sauvegarde côté serveur (debounce 2 s). Supprimé
 * automatiquement à la soumission. TTL recommandé : 30 jours (cron cleanup).
 * Un seul draft par (cjsUid, opportuniteId).
 */
model CandidatureDraft {
  cjsUid        String   @map("cjs_uid") @db.VarChar(36)
  opportuniteId String   @map("opportunite_id") @db.VarChar(36)
  lettre        String?  @db.Text
  cvUrl         String?  @map("cv_url") @db.VarChar(500)
  consent       Boolean  @default(false)
  cvMode        String   @default("upload") @map("cv_mode") @db.VarChar(20)
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid], onDelete: Cascade)
  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@id([cjsUid, opportuniteId])
  @@index([cjsUid])
  @@index([updatedAt])
  @@map("candidature_drafts")
}

// Favori d'opportunité — aligné sur le pattern RessourceFavorite (clé composite, pas de uuid).
model OpportuniteFavorite {
  cjsUid        String   @map("cjs_uid") @db.VarChar(36)
  opportuniteId String   @map("opportunite_id") @db.VarChar(36)
  createdAt     DateTime @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid], onDelete: Cascade)
  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@id([cjsUid, opportuniteId])
  @@index([cjsUid])
  @@map("opportunites_favorites")
}

// ─────────────────────────────────────────────
// M4 — CENTRES CJS
// ─────────────────────────────────────────────

model Centre {
  id          String   @id @default(uuid()) @db.VarChar(36)
  nom         String   @db.VarChar(200)
  region      Region
  adresse     String   @db.VarChar(300)
  latitude    Float
  longitude   Float
  telephone   String   @db.VarChar(20)
  responsable String   @db.VarChar(150)
  gcId        Int?     @unique @map("gc_id")
  estActif    Boolean  @default(true) @map("est_actif")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Lot 7 — Centres CJS (GUIC-350)
  slug             String? @unique @db.VarChar(120)
  description      String? @db.Text
  imageUrl         String? @map("image_url") @db.VarChar(500)
  email            String? @db.VarChar(255)
  ville            String? @db.VarChar(120)
  // JSON string[] de valeurs CentreService (cf enum) — Json pour flexibilité
  services         Json    @default("[]")
  conseillersCount Int     @default(0) @map("conseillers_count")

  evenements       Evenement[]
  agents           AgentCentre[]
  horaires         CentreHoraire[]
  ressources       RessourceCentre[]
  reservations     Reservation[]
  checkIns         CheckIn[]
  events           CentreEvent[]
  profilsRattaches ProfilJeune[]     @relation("ProfilCentrePrincipal")
  insertions       Insertion[]
  // Lot 3 — Bibliothèque physique (GUIC-274) : exemplaires localisés dans ce centre
  exemplaires      Exemplaire[]

  @@index([region])
  @@index([slug])
  @@map("centres")
}

/// Insertion professionnelle d'un jeune (emploi/stage/formation) — base du taux d'insertion (GUIC-469).
model Insertion {
  id            String   @id @default(uuid()) @db.VarChar(36)
  cjsUid        String   @map("cjs_uid") @db.VarChar(36)
  opportuniteId String?  @map("opportunite_id") @db.VarChar(36)
  centreId      String?  @map("centre_id") @db.VarChar(36)
  type          String?  @db.VarChar(50)
  dateInsertion DateTime @default(now()) @map("date_insertion")
  createdAt     DateTime @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid])
  centre      Centre?     @relation(fields: [centreId], references: [id])

  @@index([cjsUid])
  @@index([centreId])
  @@index([dateInsertion])
  @@map("insertions")
}

model AgentCentre {
  id        String    @id @default(uuid()) @db.VarChar(36)
  cjsUid    String    @map("cjs_uid") @db.VarChar(36)
  centreId  String    @map("centre_id") @db.VarChar(36)
  role      RoleAgent @default(conseiller)
  createdAt DateTime  @default(now()) @map("created_at")

  centre Centre @relation(fields: [centreId], references: [id])

  @@unique([cjsUid, centreId])
  @@map("agents_centres")
}

// ─────────────────────────────────────────────
// M5 — AGENDA / ÉVÉNEMENTS
// ─────────────────────────────────────────────

model Evenement {
  id           String          @id @default(uuid()) @db.VarChar(36)
  drupalNid    Int?            @unique @map("drupal_nid")
  titre        String          @db.VarChar(255)
  description  String          @db.Text
  type         TypeEvenement
  statut       StatutEvenement @default(a_venir)
  dateDebut    DateTime        @map("date_debut")
  dateFin      DateTime?       @map("date_fin")
  lieu         String          @db.VarChar(200)
  centreId     String?         @map("centre_id") @db.VarChar(36)
  capaciteMax  Int?            @map("capacite_max")
  estGratuit   Boolean         @default(true) @map("est_gratuit")
  // Rappel SMS envoyé 24h avant (job planifié vérifie ce flag)
  rappelEnvoye Boolean         @default(false) @map("rappel_envoye")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  centre       Centre?                @relation(fields: [centreId], references: [id])
  inscriptions InscriptionEvenement[]

  @@index([dateDebut, statut])
  @@map("evenements")
}

model InscriptionEvenement {
  id          String            @id @default(uuid()) @db.VarChar(36)
  cjsUid      String            @map("cjs_uid") @db.VarChar(36)
  evenementId String            @map("evenement_id") @db.VarChar(36)
  statut      StatutInscription @default(inscrit)
  inscritA    DateTime          @default(now()) @map("inscrit_a")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid])
  evenement   Evenement   @relation(fields: [evenementId], references: [id])

  @@unique([cjsUid, evenementId])
  @@map("inscriptions_evenements")
}

// ─────────────────────────────────────────────
// M6 — RESSOURCES PÉDAGOGIQUES
// ─────────────────────────────────────────────

model Ressource {
  id          String           @id @default(uuid()) @db.VarChar(36)
  drupalNid   Int?             @unique @map("drupal_nid")
  titre       String           @db.VarChar(255)
  description String           @db.Text
  type        TypeRessource
  theme       String           @db.VarChar(100)
  url         String           @db.VarChar(500)
  estPublic   Boolean          @default(true) @map("est_public")
  vues        Int              @default(0)
  // GUIC-24 — filtres avancés. Nullable : enrichissement progressif côté admin.
  niveau      NiveauRessource? @map("niveau")
  langue      LangueRessource? @map("langue")
  categorie   String?          @map("categorie") @db.VarChar(100)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  favoris RessourceFavorite[]

  @@index([type, theme])
  @@index([niveau])
  @@index([langue])
  @@map("ressources")
}

model RessourceFavorite {
  cjsUid      String   @map("cjs_uid") @db.VarChar(36)
  ressourceId String   @map("ressource_id") @db.VarChar(36)
  createdAt   DateTime @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid])
  ressource   Ressource   @relation(fields: [ressourceId], references: [id])

  @@id([cjsUid, ressourceId])
  @@map("ressources_favorites")
}

// ─────────────────────────────────────────────
// M10 — INTEROPÉRABILITÉ : LOGS
// Les webhooks entrants utilisent Redis pour l'idempotence (event_id, TTL 7j)
// InteropLog persiste pour audit et debugging uniquement
// ─────────────────────────────────────────────

model InteropLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  source      String   @db.VarChar(50)
  eventType   String   @map("event_type") @db.VarChar(100)
  eventId     String   @map("event_id") @db.VarChar(100)
  payload     Json
  statut      String   @db.VarChar(20)
  erreur      String?  @db.Text
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([source, eventType])
  @@index([eventId])
  @@map("interop_logs")
}

// ─────────────────────────────────────────────
