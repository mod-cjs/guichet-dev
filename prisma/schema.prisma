generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────
// ÉNUMÉRATIONS
// ─────────────────────────────────────────────

enum Region {
  Dakar
  Thies
  Diourbel
  Fatick
  Kaolack
  Kaffrine
  Louga
  Saint_Louis
  Matam
  Tambacounda
  Kedougou
  Kolda
  Ziguinchor
  Sedhiou

  @@map("region")
}

enum Genre {
  M
  F

  @@map("genre")
}

enum StatutCompte {
  actif
  inactif
  anonymise

  @@map("statut_compte")
}

enum TypeOpportunite {
  Emploi
  Stage
  Formation
  Bourse
  Volontariat
  Appel_a_projets

  @@map("type_opportunite")
}

/// Type de contrat employé sur OpportuniteEmploi (GUIC-183 / 178b).
enum TypeContrat {
  CDI
  CDD
  FREELANCE
  ALTERNANCE
  STAGE_ALTERNE

  @@map("type_contrat")
}

/// Modalité pédagogique sur OpportuniteFormation (GUIC-183 / 178b).
enum ModaliteFormation {
  PRESENTIEL
  DISTANCE
  HYBRIDE

  @@map("modalite_formation")
}

/// Niveau d'études minimum requis (GUIC-183 / 178b).
/// Décision Q8 spec §18 : enum strict (override DP6 String libre).
enum NiveauEtudes {
  BFEM
  BAC
  BAC_PLUS_2
  BAC_PLUS_3
  BAC_PLUS_5
  DOCTORAT

  @@map("niveau_etudes")
}

/// Type de financement (GUIC-183 / 178b post-audit — spec §19).
enum TypeFinancement {
  MICROCREDIT
  SUBVENTION
  DOTATION
  PRET_HONNEUR
  CAPITAL_AMORCAGE

  @@map("type_financement")
}

/// Modalité de mentorat (GUIC-183 / 178b post-audit — spec §19).
enum ModaliteMentorat {
  INDIVIDUEL
  GROUPE
  COHORTE

  @@map("modalite_mentorat")
}

/// Type de mobilité (GUIC-183 / 178b post-audit — spec §19).
enum TypeMobilite {
  ETUDE
  STAGE
  PROFESSIONNELLE
  RECHERCHE

  @@map("type_mobilite")
}

/// Type de volontariat (GUIC-183 / 178b post-audit — spec §19).
enum TypeVolontariat {
  SERVICE_CIVIQUE
  ENGAGEMENT
  INTERNATIONAL
  HUMANITAIRE

  @@map("type_volontariat")
}

enum Domaine {
  Agriculture
  Numerique
  Entrepreneuriat
  Citoyennete
  Environnement
  Sante
  Education
  Culture
  Autre

  @@map("domaine")
}

enum StatutOpportunite {
  brouillon
  publiee
  archivee
  expiree

  @@map("statut_opportunite")
}

enum StatutCandidature {
  En_attente
  Vue
  Retenue
  Refusee

  @@map("statut_candidature")
}

enum TypeEvenement {
  Formation
  Atelier
  Forum
  Webinar
  Conference

  @@map("type_evenement")
}

enum StatutEvenement {
  a_venir
  en_cours
  termine
  annule

  @@map("statut_evenement")
}

enum TypeRessource {
  PDF
  Video
  Lien
  Guide
  Outil

  @@map("type_ressource")
}

enum StatutInscription {
  inscrit
  liste_attente
  annule
  present

  @@map("statut_inscription")
}

enum RoleAgent {
  conseiller
  directeur
  admin_centre

  @@map("role_agent")
}

// ─────────────────────────────────────────────
// M1 — SOCLE : UTILISATEURS & PROFILS
// ─────────────────────────────────────────────

// Identité de base — synchronisée depuis le SSO via webhook user.*
// Ne jamais modifier directement : la source de vérité est le SSO CJS
model Utilisateur {
  cjsUid             String       @id @map("cjs_uid") @db.VarChar(36)
  telephone          String?      @unique @db.VarChar(20)
  email              String?      @unique @db.VarChar(255)
  nom                String       @db.VarChar(100)
  prenom             String       @db.VarChar(100)
  region             Region?
  genre              Genre?
  dateNaissance      DateTime?    @map("date_naissance")
  statut             StatutCompte @default(actif)
  commune            String?      @db.VarChar(100)
  onboardingComplete Boolean      @default(false) @map("onboarding_complete")
  drupalUid          Int?         @unique @map("drupal_uid")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")

  profil                ProfilJeune?
  candidatures          Candidature[]
  inscriptions          InscriptionEvenement[]
  ressourcesFavoris     RessourceFavorite[]
  opportunitesFavorites OpportuniteFavorite[]
  conversations         ConversationWhatsApp[]
  recommandations       RecommandationIA[]

  @@index([email])
  @@index([telephone])
  @@index([statut])
  @@map("utilisateurs")
}

// Profil enrichi — rempli par le jeune après inscription
model ProfilJeune {
  id                String   @id @default(uuid()) @db.VarChar(36)
  cjsUid            String   @unique @map("cjs_uid") @db.VarChar(36)
  photoUrl          String?  @map("photo_url") @db.VarChar(500)
  biographie        String?  @db.Text
  // JSON arrays stockés en texte — ex: ["JavaScript","Python"] ou ["Agriculture","Numérique"]
  competences       Json?
  domainesInteret   Json?    @map("domaines_interet")
  niveauEtude       String?  @map("niveau_etude") @db.VarChar(50)
  situationEmploi   String?  @map("situation_emploi") @db.VarChar(50)
  // Score 0–100 calculé et mis à jour dans ProfilService.recalculerScore()
  completionScore   Int      @default(0) @map("completion_score")
  profileVisibility String   @default("public") @map("profile_visibility") @db.VarChar(20)
  // CV stocké (GUIC-223 / GUIC-224) — réutilisable depuis CandidatureModal
  cvUrl             String?  @map("cv_url") @db.VarChar(500)
  cvUploadedAt      DateTime? @map("cv_uploaded_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  utilisateur Utilisateur        @relation(fields: [cjsUid], references: [cjsUid])
  experiences Experience[]
  diplomes    Diplome[]
  certificats CertificatMoodle[]

  @@map("profils_jeunes")
}

// Expériences professionnelles du jeune
model Experience {
  id           String    @id @default(uuid()) @db.VarChar(36)
  profilId     String    @map("profil_id") @db.VarChar(36)
  poste        String    @db.VarChar(150)
  organisation String    @db.VarChar(150)
  dateDebut    DateTime  @map("date_debut")
  dateFin      DateTime? @map("date_fin")
  description  String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  profil ProfilJeune @relation(fields: [profilId], references: [id], onDelete: Cascade)

  @@index([profilId])
  @@map("experiences")
}

// Diplômes du jeune (GUIC-19) — remplace l'ancienne colonne Json `diplomes`
model Diplome {
  id             String   @id @default(uuid()) @db.VarChar(36)
  profilId       String   @map("profil_id") @db.VarChar(36)
  intitule       String   @db.VarChar(200)
  etablissement  String   @db.VarChar(200)
  anneeObtention Int      @map("annee_obtention")
  niveau         String   @db.VarChar(50)
  mention        String?  @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  profil ProfilJeune @relation(fields: [profilId], references: [id], onDelete: Cascade)

  @@index([profilId])
  @@map("diplomes")
}

// ─────────────────────────────────────────────
// M2 — ORGANISATION RECRUTEUR
// ─────────────────────────────────────────────

model Organisation {
  id         String   @id @default(uuid()) @db.VarChar(36)
  cjsUid     String   @map("cjs_uid") @db.VarChar(36)
  nom        String   @db.VarChar(200)
  secteur    Domaine?
  region     Region?
  adresse    String?  @db.VarChar(300)
  telephone  String?  @db.VarChar(20)
  email      String?  @db.VarChar(255)
  siteWeb    String?  @map("site_web") @db.VarChar(500)
  logoUrl    String?  @map("logo_url") @db.VarChar(500)
  estVerifie Boolean  @default(false) @map("est_verifie")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  opportunites Opportunite[]

  @@index([cjsUid])
  @@map("organisations")
}

// ─────────────────────────────────────────────
// M3 — OPPORTUNITÉS & CANDIDATURES
// ─────────────────────────────────────────────

/// Table mère M3 v2 (CTI). Colonnes legacy (type, organisation) conservées
/// pendant la migration data — supprimées en 178d après backfill.
/// Les colonnes polymorphiques (typeId, programmeId, organisationId déjà présent,
/// organisationLibelle, niveauEtudeMin) sont ajoutées en NULL dans cette étape (178b)
/// pour ne pas casser les rows existantes ; elles passent NOT NULL en 178d.
/// L'invariant XOR (1 et 1 seul sous-type non null) est garanti côté applicatif
/// via OpportuniteService — cf. spec §8.4 et `opportunite-integrity.ts`.
model Opportunite {
  id          String @id @default(uuid()) @db.VarChar(36)
  drupalNid   Int?   @unique @map("drupal_nid")
  slug        String @unique @db.VarChar(280)
  titre       String @db.VarChar(255)
  description String @db.LongText

  // Champs legacy — conservés jusqu'en 178d (drop après backfill)
  type         TypeOpportunite
  organisation String          @db.VarChar(200)

  // Nouveaux champs polymorphiques (nullable durant migration data — 178b/c)
  typeId              String?       @map("type_id") @db.VarChar(36)
  programmeId         String?       @map("programme_id") @db.VarChar(36)
  organisationLibelle String?       @map("organisation_libelle") @db.VarChar(200)
  niveauEtudeMin      NiveauEtudes? @map("niveau_etude_min")

  domaine        Domaine
  region         Region?
  organisationId String?           @map("organisation_id") @db.VarChar(36)
  remuneration   String?           @db.VarChar(100)
  deadline       DateTime?
  lienExterne    String?           @map("lien_externe") @db.VarChar(500)
  statut         StatutOpportunite @default(brouillon)
  recruteurUid   String?           @map("recruteur_uid") @db.VarChar(36)
  vues           Int               @default(0)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  org       Organisation?    @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  typeRef   OpportuniteType? @relation(fields: [typeId], references: [id])
  programme Programme?       @relation(fields: [programmeId], references: [id], onDelete: SetNull)

  // Sous-types 1:1 (un seul des dix non-null — invariant applicatif)
  // Spec §19 — 4 sous-types ajoutés post-audit guichetjeunesse.sn (2026-06-01)
  emploi        OpportuniteEmploi?
  stage         OpportuniteStage?
  formation     OpportuniteFormation?
  bourse        OpportuniteBourse?
  concours      OpportuniteConcours?
  appelAProjets OpportuniteAppelAProjets?
  financement   OpportuniteFinancement?
  mentorat      OpportuniteMentorat?
  mobilite      OpportuniteMobilite?
  volontariat   OpportuniteVolontariat?

  skills       OpportuniteSkill[]
  tags         OpportuniteTag[]
  candidatures Candidature[]
  favoris      OpportuniteFavorite[]

  @@index([statut, deletedAt])
  @@index([type, domaine])
  @@index([typeId, domaine])
  @@index([programmeId])
  @@index([region])
  @@index([deadline])
  @@fulltext([titre, description])
  @@map("opportunites")
}

model Candidature {
  id                   String            @id @default(uuid()) @db.VarChar(36)
  cjsUid               String            @map("cjs_uid") @db.VarChar(36)
  opportuniteId        String            @map("opportunite_id") @db.VarChar(36)
  statut               StatutCandidature @default(En_attente)
  lettreMotivation     String?           @map("lettre_motivation") @db.Text
  cvUrl                String?           @map("cv_url") @db.VarChar(500)
  notificationsConsent Boolean           @default(false) @map("notifications_consent")
  soumiseA             DateTime          @default(now()) @map("soumise_a")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid], onDelete: Cascade)
  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@unique([cjsUid, opportuniteId])
  @@index([statut])
  @@map("candidatures")
}

// Favori d'opportunité — aligné sur le pattern RessourceFavorite (clé composite, pas de uuid).
model OpportuniteFavorite {
  cjsUid        String   @map("cjs_uid") @db.VarChar(36)
  opportuniteId String   @map("opportunite_id") @db.VarChar(36)
  createdAt     DateTime @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid], onDelete: Cascade)
  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@id([cjsUid, opportuniteId])
  @@index([cjsUid])
  @@map("opportunites_favorites")
}

// ─────────────────────────────────────────────
// M4 — CENTRES CJS
// ─────────────────────────────────────────────

model Centre {
  id          String   @id @default(uuid()) @db.VarChar(36)
  nom         String   @db.VarChar(200)
  region      Region
  adresse     String   @db.VarChar(300)
  latitude    Float
  longitude   Float
  telephone   String   @db.VarChar(20)
  responsable String   @db.VarChar(150)
  gcId        Int?     @unique @map("gc_id")
  estActif    Boolean  @default(true) @map("est_actif")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  evenements Evenement[]
  agents     AgentCentre[]

  @@index([region])
  @@map("centres")
}

model AgentCentre {
  id        String    @id @default(uuid()) @db.VarChar(36)
  cjsUid    String    @map("cjs_uid") @db.VarChar(36)
  centreId  String    @map("centre_id") @db.VarChar(36)
  role      RoleAgent @default(conseiller)
  createdAt DateTime  @default(now()) @map("created_at")

  centre Centre @relation(fields: [centreId], references: [id])

  @@unique([cjsUid, centreId])
  @@map("agents_centres")
}

// ─────────────────────────────────────────────
// M5 — AGENDA / ÉVÉNEMENTS
// ─────────────────────────────────────────────

model Evenement {
  id           String          @id @default(uuid()) @db.VarChar(36)
  drupalNid    Int?            @unique @map("drupal_nid")
  titre        String          @db.VarChar(255)
  description  String          @db.Text
  type         TypeEvenement
  statut       StatutEvenement @default(a_venir)
  dateDebut    DateTime        @map("date_debut")
  dateFin      DateTime?       @map("date_fin")
  lieu         String          @db.VarChar(200)
  centreId     String?         @map("centre_id") @db.VarChar(36)
  capaciteMax  Int?            @map("capacite_max")
  estGratuit   Boolean         @default(true) @map("est_gratuit")
  // Rappel SMS envoyé 24h avant (job planifié vérifie ce flag)
  rappelEnvoye Boolean         @default(false) @map("rappel_envoye")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  centre       Centre?                @relation(fields: [centreId], references: [id])
  inscriptions InscriptionEvenement[]

  @@index([dateDebut, statut])
  @@map("evenements")
}

model InscriptionEvenement {
  id          String            @id @default(uuid()) @db.VarChar(36)
  cjsUid      String            @map("cjs_uid") @db.VarChar(36)
  evenementId String            @map("evenement_id") @db.VarChar(36)
  statut      StatutInscription @default(inscrit)
  inscritA    DateTime          @default(now()) @map("inscrit_a")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid])
  evenement   Evenement   @relation(fields: [evenementId], references: [id])

  @@unique([cjsUid, evenementId])
  @@map("inscriptions_evenements")
}

// ─────────────────────────────────────────────
// M6 — RESSOURCES PÉDAGOGIQUES
// ─────────────────────────────────────────────

model Ressource {
  id          String        @id @default(uuid()) @db.VarChar(36)
  drupalNid   Int?          @unique @map("drupal_nid")
  titre       String        @db.VarChar(255)
  description String        @db.Text
  type        TypeRessource
  theme       String        @db.VarChar(100)
  url         String        @db.VarChar(500)
  estPublic   Boolean       @default(true) @map("est_public")
  vues        Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  favoris RessourceFavorite[]

  @@index([type, theme])
  @@map("ressources")
}

model RessourceFavorite {
  cjsUid      String   @map("cjs_uid") @db.VarChar(36)
  ressourceId String   @map("ressource_id") @db.VarChar(36)
  createdAt   DateTime @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid])
  ressource   Ressource   @relation(fields: [ressourceId], references: [id])

  @@id([cjsUid, ressourceId])
  @@map("ressources_favorites")
}

// ─────────────────────────────────────────────
// M10 — INTEROPÉRABILITÉ : LOGS
// Les webhooks entrants utilisent Redis pour l'idempotence (event_id, TTL 7j)
// InteropLog persiste pour audit et debugging uniquement
// ─────────────────────────────────────────────

model InteropLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  source      String   @db.VarChar(50)
  eventType   String   @map("event_type") @db.VarChar(100)
  eventId     String   @map("event_id") @db.VarChar(100)
  payload     Json
  statut      String   @db.VarChar(20)
  erreur      String?  @db.Text
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([source, eventType])
  @@index([eventId])
  @@map("interop_logs")
}

// ─────────────────────────────────────────────
// M11 — WHATSAPP AÏSSATOU
// ─────────────────────────────────────────────

model ConversationWhatsApp {
  id        String   @id @default(uuid()) @db.VarChar(36)
  telephone String   @db.VarChar(20)
  cjsUid    String?  @map("cjs_uid") @db.VarChar(36)
  // Contexte de conversation sérialisé (historique Groq)
  contexte  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  utilisateur Utilisateur?      @relation(fields: [cjsUid], references: [cjsUid])
  messages    MessageWhatsApp[]

  @@unique([telephone])
  @@map("conversations_whatsapp")
}

model MessageWhatsApp {
  id             String   @id @default(uuid()) @db.VarChar(36)
  conversationId String   @map("conversation_id") @db.VarChar(36)
  wamid          String   @unique @db.VarChar(100)
  sens           String   @db.VarChar(10)
  contenu        String   @db.Text
  type           String   @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ConversationWhatsApp @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("messages_whatsapp")
}

// ─────────────────────────────────────────────
// M12 — RECOMMANDATIONS IA
// ─────────────────────────────────────────────

model RecommandationIA {
  id            String    @id @default(uuid()) @db.VarChar(36)
  cjsUid        String    @map("cjs_uid") @db.VarChar(36)
  opportuniteId String?   @map("opportunite_id") @db.VarChar(36)
  score         Float
  raison        String?   @db.Text
  vuePar        DateTime? @map("vue_par")
  createdAt     DateTime  @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid])

  @@index([cjsUid, score(sort: Desc)])
  @@map("recommandations_ia")
}

// ─────────────────────────────────────────────
// M14 — CERTIFICATS MOODLE
// ─────────────────────────────────────────────

model CertificatMoodle {
  id            String   @id @default(uuid()) @db.VarChar(36)
  profilId      String   @map("profil_id") @db.VarChar(36)
  moodleCertId  String   @unique @map("moodle_cert_id") @db.VarChar(100)
  formation     String   @db.VarChar(255)
  obtenuLe      DateTime @map("obtenu_le")
  urlCertificat String?  @map("url_certificat") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")

  profil ProfilJeune @relation(fields: [profilId], references: [id])

  @@index([profilId])
  @@map("certificats_moodle")
}

// ─────────────────────────────────────────────
// ONBOARDING DRAFT
// ─────────────────────────────────────────────
// Brouillon onboarding persisté server-side (remplace sessionStorage).
// Permet la reprise multi-device et la résilience (cybercafé, switch desktop/mobile).
// Une seule ligne par utilisateur (clé = cjs_uid). Supprimé à la finalisation.
model OnboardingDraft {
  cjsUid        String    @id @map("cjs_uid") @db.VarChar(36)
  // Tableau d'IDs d'objectifs (ex: ["emploi","projet"]) — JSON
  objectifs     Json?
  telephone     String?   @db.VarChar(20)
  prenom        String?   @db.VarChar(100)
  nom           String?   @db.VarChar(100)
  dateNaissance DateTime? @map("date_naissance")
  // Stocké en VARCHAR car peut contenir une valeur non encore alignée sur l'enum Region (saisie partielle).
  genre         String?   @db.VarChar(20)
  region        String?   @db.VarChar(50)
  commune       String?   @db.VarChar(100)
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("onboarding_drafts")
}

// ─────────────────────────────────────────────
// M3 v2 — Tables de référence (GUIC-182 / 178a/4)
// Voir .agent_context/specs/M3-schema-polymorphique.md §3
// Les jonctions OpportuniteSkill / OpportuniteTag arrivent en 178b
// (FK vers la nouvelle table Opportunite polymorphique).
// ─────────────────────────────────────────────

/// Programmes sectoriels CJS (4 — Yaakaar, YEAH, YJC, EduPop).
/// BRM = outil interne, exclu (décision Lead 2026-05-29).
model Programme {
  id            String   @id @default(uuid()) @db.VarChar(36)
  slug          String   @unique @db.VarChar(40)
  nom           String   @db.VarChar(80)
  description   String   @db.VarChar(255)
  gradientToken String   @map("gradient_token") @db.VarChar(80)
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  opportunites Opportunite[]

  @@map("programmes")
}

/// Types d'opportunité — remplace l'enum TypeOpportunite (qui survit pendant migration).
/// Permet d'ajouter dynamiquement actionLabel / workflow sans migration Prisma.
model OpportuniteType {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  slug               String   @unique @db.VarChar(40)
  libelle            String   @db.VarChar(80)
  actionLabel        String   @map("action_label") @db.VarChar(40)
  requiresFileUpload Boolean  @default(false) @map("requires_file_upload")
  fileLabel          String?  @map("file_label") @db.VarChar(80)
  decisionAuthority  String?  @map("decision_authority") @db.VarChar(100)
  actif              Boolean  @default(true)
  ordre              Int      @default(0)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  opportunites Opportunite[]

  @@map("opportunite_types")
}

/// Compétences requises sur les opportunités (M:N).
/// Jonction OpportuniteSkill créée en 178b avec la table Opportunite mère.
model Skill {
  id        String   @id @default(uuid()) @db.VarChar(36)
  slug      String   @unique @db.VarChar(80)
  libelle   String   @db.VarChar(120)
  categorie String?  @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at")

  opportunites OpportuniteSkill[]

  @@map("skills")
}

/// Tags transversaux (urgent, télétravail, diaspora…).
/// Jonction OpportuniteTag créée en 178b avec la table Opportunite mère.
model Tag {
  id        String   @id @default(uuid()) @db.VarChar(36)
  slug      String   @unique @db.VarChar(80)
  libelle   String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  opportunites OpportuniteTag[]

  @@map("tags")
}

// ─────────────────────────────────────────────
// M3 v2 — Sous-types CTI (GUIC-183 / 178b/4)
// Cf. spec §3.4 et §3.5 — relations 1:1 vers Opportunite avec cascade.
// L'invariant XOR (exactement 1 sous-type non-null par Opportunite) est
// garanti côté applicatif via OpportuniteService (cf. spec §8.4) ; pas de
// CHECK SQL portable MariaDB.
// ─────────────────────────────────────────────

model OpportuniteEmploi {
  opportuniteId     String        @id @map("opportunite_id") @db.VarChar(36)
  typeContrat       TypeContrat   @map("type_contrat")
  dureeContratMois  Int?          @map("duree_contrat_mois")
  experienceRequise String?       @map("experience_requise") @db.VarChar(100)
  teletravail       Boolean       @default(false)
  niveauEtudeMin    NiveauEtudes? @map("niveau_etude_min")

  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@map("opportunites_emploi")
}

model OpportuniteStage {
  opportuniteId          String        @id @map("opportunite_id") @db.VarChar(36)
  dureeMois              Int           @map("duree_mois")
  conventionneEcole      Boolean       @default(false) @map("conventionne_ecole")
  indemnise              Boolean       @default(false)
  indemniteMensuelleFcfa Int?          @map("indemnite_mensuelle_fcfa")
  niveauEtudeMin         NiveauEtudes? @map("niveau_etude_min")
  dateDebutPrevue        DateTime?     @map("date_debut_prevue")

  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@map("opportunites_stage")
}

model OpportuniteFormation {
  opportuniteId          String            @id @map("opportunite_id") @db.VarChar(36)
  dureeHeures            Int               @map("duree_heures")
  modalite               ModaliteFormation
  certifiante            Boolean           @default(false)
  organismeCertificateur String?           @map("organisme_certificateur") @db.VarChar(150)
  prerequis              String?           @db.Text
  gratuite               Boolean           @default(true)
  fraisInscriptionFcfa   Int?              @map("frais_inscription_fcfa")

  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@map("opportunites_formation")
}

model OpportuniteBourse {
  opportuniteId      String        @id @map("opportunite_id") @db.VarChar(36)
  montantTotalFcfa   Int           @map("montant_total_fcfa")
  dureeMois          Int?          @map("duree_mois")
  niveauEtudeRequis  NiveauEtudes? @map("niveau_etude_requis")
  paysDestination    String?       @map("pays_destination") @db.VarChar(80)
  organismeFinanceur String        @map("organisme_financeur") @db.VarChar(150)
  coupleObligatoire  Boolean       @default(false) @map("couple_obligatoire")

  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@map("opportunites_bourse")
}

model OpportuniteConcours {
  opportuniteId         String    @id @map("opportunite_id") @db.VarChar(36)
  organismeOrganisateur String    @map("organisme_organisateur") @db.VarChar(150)
  dateEpreuves          DateTime? @map("date_epreuves")
  lieuEpreuves          String?   @map("lieu_epreuves") @db.VarChar(200)
  preuvesDemandees      String?   @map("preuves_demandees") @db.Text
  placesDisponibles     Int?      @map("places_disponibles")

  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@map("opportunites_concours")
}

model OpportuniteAppelAProjets {
  opportuniteId       String  @id @map("opportunite_id") @db.VarChar(36)
  budgetMaxFcfa       Int?    @map("budget_max_fcfa")
  dureeProjetMois     Int?    @map("duree_projet_mois")
  thematique          String? @db.VarChar(150)
  dossierRequis       String  @map("dossier_requis") @db.Text
  criteresEligibilite String  @map("criteres_eligibilite") @db.Text

  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@map("opportunites_appel_a_projets")
}

// Jonctions M:N (Skills, Tags)

model OpportuniteSkill {
  opportuniteId String  @map("opportunite_id") @db.VarChar(36)
  skillId       String  @map("skill_id") @db.VarChar(36)
  requise       Boolean @default(true)

  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([opportuniteId, skillId])
  @@index([skillId])
  @@map("opportunites_skills")
}

model OpportuniteTag {
  opportuniteId String @map("opportunite_id") @db.VarChar(36)
  tagId         String @map("tag_id") @db.VarChar(36)

  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([opportuniteId, tagId])
  @@index([tagId])
  @@map("opportunites_tags")
}

// ─────────────────────────────────────────────
// M3 v2 — Sous-types post-audit guichetjeunesse.sn (GUIC-183 / 178b — spec §19)
// 4 sous-types ajoutés 2026-06-01 : FINANCEMENT, MENTORAT, MOBILITE, VOLONTARIAT
// ─────────────────────────────────────────────

/// Financements (microcrédit, subvention, dotation, prêt d'honneur, capital amorçage).
/// Distinct d'OpportuniteAppelAProjets : guichet ouvert, décideur = officier de crédit
/// (pas un jury de sélection compétitive).
model OpportuniteFinancement {
  opportuniteId          String          @id @map("opportunite_id") @db.VarChar(36)
  montantFcfa            Int             @map("montant_fcfa")
  typeFinancement        TypeFinancement @map("type_financement")
  tauxAnnuel             Decimal?        @map("taux_annuel") @db.Decimal(5, 2)
  garanties              String?         @db.Text
  dureeRemboursementMois Int?            @map("duree_remboursement_mois")
  organismeFinanceur     String          @map("organisme_financeur") @db.VarChar(150)
  isContinuous           Boolean         @default(false) @map("is_continuous")
  dateLimiteDepot        DateTime?       @map("date_limite_depot")

  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@map("opportunites_financement")
}

/// Mentorat (incubation, coaching cohorte).
model OpportuniteMentorat {
  opportuniteId       String           @id @map("opportunite_id") @db.VarChar(36)
  dureeMois           Int              @map("duree_mois")
  modalite            ModaliteMentorat
  thematique          String?          @db.VarChar(150)
  placesDisponibles   Int?             @map("places_disponibles")
  organisateurLibelle String           @map("organisateur_libelle") @db.VarChar(150)

  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@map("opportunites_mentorat")
}

/// Mobilité (étude, stage, pro, recherche — internationale ou régionale).
model OpportuniteMobilite {
  opportuniteId      String       @id @map("opportunite_id") @db.VarChar(36)
  destination        String       @db.VarChar(120)
  typeMobilite       TypeMobilite @map("type_mobilite")
  dureeMois          Int          @map("duree_mois")
  prisEnCharge       String?      @map("pris_en_charge") @db.Text
  niveauLangueRequis String?      @map("niveau_langue_requis") @db.VarChar(50)
  dateDepartPrevue   DateTime?    @map("date_depart_prevue")

  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@map("opportunites_mobilite")
}

/// Volontariat (service civique, engagement, international, humanitaire).
model OpportuniteVolontariat {
  opportuniteId          String          @id @map("opportunite_id") @db.VarChar(36)
  dureeMois              Int             @map("duree_mois")
  typeVolontariat        TypeVolontariat @map("type_volontariat")
  indemniteMensuelleFcfa Int?            @map("indemnite_mensuelle_fcfa")
  domaineMission         String          @map("domaine_mission") @db.VarChar(150)
  placesDisponibles      Int?            @map("places_disponibles")

  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@map("opportunites_volontariat")
}
