// ─────────────────────────────────────────────
// M4 — LOT 7 CENTRES CJS (GUIC-350)
// Spec : .agent_context/specs/M4-centres-lot7.md
// ADR-001 : réutilisation AgentCentre + RoleAgent (pas de CentreStaff)
// ─────────────────────────────────────────────

/// Services disponibles dans un centre CJS (stockés en Json string[] sur Centre.services).
enum CentreService {
  WiFi
  Bibliotheque
  Coworking
  Ateliers
  Conseiller
  Salle_reunion
  Postes_info
  Imprimante
  Cafe
  Espace_detente

  @@map("centre_service")
}

enum Jour {
  Lundi
  Mardi
  Mercredi
  Jeudi
  Vendredi
  Samedi
  Dimanche

  @@map("jour")
}

enum TypeRessourceCentre {
  Salle
  Vehicule
  Poste_info
  Equipement
  Atelier_recurrent

  @@map("type_ressource_centre")
}

enum StatutReservation {
  EnAttente // workflow approval — désactivé MVP
  Acceptee // auto-validée MVP
  Refusee
  AnnuleeParJeune
  AnnuleeParCentre // GUIC-395 : annulation par le staff (raisonRefusOuAnnul = motif)
  Passee // batch quotidien : date passée + statut != Annulee/Refusee
  NonHonoree // batch : date passée + pas de CheckIn associé

  @@map("statut_reservation")
}

enum CheckInVia {
  QrCard // QR de la MyCJSCard scanné
  Manuel // staff a entré manuellement

  @@map("check_in_via")
}

/// Horaires d'ouverture par centre × jour (configurable, fallback standard si vide).
model CentreHoraire {
  centreId String  @map("centre_id") @db.VarChar(36)
  jour     Jour
  ouvert   Boolean @default(true)
  ouvreA   String? @map("ouvre_a") @db.VarChar(5) // "08:00"
  fermeA   String? @map("ferme_a") @db.VarChar(5) // "18:00"

  centre Centre @relation(fields: [centreId], references: [id], onDelete: Cascade)

  @@id([centreId, jour])
  @@map("centre_horaires")
}

/// Ressources réservables par un jeune dans un centre (salles, véhicules, postes info...).
model RessourceCentre {
  id                 String              @id @default(uuid()) @db.VarChar(36)
  centreId           String              @map("centre_id") @db.VarChar(36)
  type               TypeRessourceCentre
  nom                String              @db.VarChar(120)
  description        String?             @db.Text
  imageUrl           String?             @map("image_url") @db.VarChar(500)
  // Capacité variable : 1 = ressource unique, >1 = multiple (ex. salle 20 places, 5 postes info)
  capacite           Int                 @default(1)
  capaciteUnit       String?             @map("capacite_unit") @db.VarChar(30) // "personnes", "postes"
  dureeMinCreneauMin Int                 @default(60) @map("duree_min_creneau_min")
  requiresJustif     Boolean             @default(false) @map("requires_justif")
  estActive          Boolean             @default(true) @map("est_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  centre       Centre        @relation(fields: [centreId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([centreId, type, estActive])
  @@map("ressources_centre")
}

/// Réservation d'une ressource par un jeune.
/// MVP : auto-validée (statut=Acceptee) à la création.
/// Sprint+1 : workflow approval activable (StatutReservation.EnAttente).
model Reservation {
  /// Identifiant de la réservation.
  id                 String            @id @default(uuid()) @db.VarChar(36)
  /// Jeune réservant — clé de jointure vers `utilisateurs`.
  cjsUid             String            @map("cjs_uid") @db.VarChar(36)
  /// Centre où la ressource est réservée.
  centreId           String            @map("centre_id") @db.VarChar(36)
  /// Ressource matérielle réservée au sein du centre.
  ressourceId        String            @map("ressource_id") @db.VarChar(36)
  /// Jour calendaire réservé, sans heure — le créneau porte l'horaire.
  dateReservee       DateTime          @map("date_reservee") // jour calendrier
  /// Heure de début du créneau, au format HH:MM.
  creneauDebut       String            @map("creneau_debut") @db.VarChar(5)
  /// Heure de fin du créneau, au format HH:MM.
  creneauFin         String            @map("creneau_fin") @db.VarChar(5)
  /// Nombre de personnes annoncées pour le créneau.
  nombrePersonnes    Int               @default(1) @map("nombre_personnes")
  motif              String            @db.Text
  justifFileUrl      String?           @map("justif_file_url") @db.VarChar(500)
  /// `EnAttente`, `Acceptee`, `Refusee`, `AnnuleeParJeune`, `AnnuleeParCentre`, puis `Passee` ou `NonHonoree` posés par le batch quotidien.
  statut             StatutReservation @default(Acceptee)
  raisonRefusOuAnnul String?           @map("raison_refus_ou_annul") @db.Text
  /// Absence constatée : créneau passé sans passage badgé associé.
  noShow             Boolean           @default(false) @map("no_show")
  /// Date de la demande de réservation.
  createdAt          DateTime          @default(now()) @map("created_at")
  /// M13 — watermark de réplication Data Hub : le statut évolue (décision, annulation)
  /// sans qu'aucune colonne ne datait la modification.
  updatedAt          DateTime          @updatedAt @map("updated_at")
  /// Horodatage de la décision du centre sur la réservation.
  decisionA          DateTime?         @map("decision_a")
  /// Horodatage de l'annulation, quelle qu'en soit l'origine.
  annuleeA           DateTime?         @map("annulee_a")

  utilisateur Utilisateur     @relation(fields: [cjsUid], references: [cjsUid])
  centre      Centre          @relation(fields: [centreId], references: [id])
  ressource   RessourceCentre @relation(fields: [ressourceId], references: [id])
  checkIns    CheckIn[]

  @@index([cjsUid, createdAt(sort: Desc)])
  @@index([centreId, statut, dateReservee])
  @@index([ressourceId, dateReservee, statut])
  @@index([statut, dateReservee])
  @@index([updatedAt, id])
  @@map("reservations")
}

/// Check-in physique d'un jeune dans un centre (KPI fréquentation principal).
model CheckIn {
  /// Identifiant du passage.
  id              String     @id @default(uuid()) @db.VarChar(36)
  /// Jeune ayant badgé — clé de jointure vers `utilisateurs`.
  cjsUid          String     @map("cjs_uid") @db.VarChar(36)
  /// Centre où le passage a été enregistré.
  centreId        String     @map("centre_id") @db.VarChar(36)
  /// Réservation honorée par ce passage, quand il y en a une. Nul pour une visite spontanée.
  reservationId   String?    @map("reservation_id") @db.VarChar(36)
  /// Mode d'enregistrement : `QrCard` par scan de la MyCJSCard, `Manuel` par saisie du staff.
  via             CheckInVia
  scannerId       String?    @map("scanner_id") @db.VarChar(36) // cjsUid du staff scanneur
  conseillerEmail String?    @map("conseiller_email") @db.VarChar(255)
  jwtNonce        String?    @unique @map("jwt_nonce") @db.VarChar(64)
  /// Horodatage du passage. Table append-only : sert de watermark de réplication.
  effectueA       DateTime   @default(now()) @map("effectue_a")
  /// Durée de présence en minutes, quand elle a pu être mesurée.
  dwellMinutes    Int?       @map("dwell_minutes")
  meta            Json?

  utilisateur Utilisateur  @relation(fields: [cjsUid], references: [cjsUid])
  centre      Centre       @relation(fields: [centreId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@index([centreId, effectueA])
  @@index([cjsUid, effectueA])
  @@index([effectueA, id])
  @@map("check_ins")
}

/// Table KPI événementiel INSERT-only — retention 6 mois (purge auto).
/// Source : helper src/lib/analytics/centre-events.ts (fail-soft, log warning si insertion échoue).
model CentreEvent {
  id       BigInt   @id @default(autoincrement())
  centreId String?  @map("centre_id") @db.VarChar(36)
  cjsUid   String?  @map("cjs_uid") @db.VarChar(36)
  type     String   @db.VarChar(60)
  metadata Json?
  ts       DateTime @default(now())

  centre Centre? @relation(fields: [centreId], references: [id])

  @@index([type, ts])
  @@index([centreId, type, ts])
  @@map("centre_events")
}

// ─────────────────────────────────────────────
// M13 — CONSULTATIONS MULTICANAL (GUIC-688)
// Trace unifiée « qui a vu quoi, par quel canal » pour les éléments consultables
// par un bénéficiaire. Remplace à terme les compteurs dénormalisés isolés
// (`Opportunite.vues`, `Ressource.vues`) et `CentreEvent.centre_viewed`, qui
// restent alimentés en parallèle le temps de la transition.
// Source : src/lib/analytics/consultations.ts (fail-soft, dédoublonnage Redis 30 min).
// ─────────────────────────────────────────────

/// Entités dont la visualisation est traçable. `programme` et `organisation`
/// sont déclarés pour la complétude du domaine mais ne sont pas instrumentés :
/// aucune page consultable par un bénéficiaire n'existe (admin uniquement).
enum EntiteConsultable {
  opportunite
  ressource
  evenement
  centre
  livre
  programme
  organisation

  @@map("entite_consultable")
}

/// `impression` = l'élément a été AFFICHÉ (card Yaye, liste WhatsApp) sans action.
/// `consultation` = l'élément a été OUVERT (page détail). Les deux ne se comparent
/// jamais entre eux : mélanger les deux fausserait tout taux de conversion.
enum TypeConsultation {
  impression
  consultation

  @@map("type_consultation")
}

/// Canal d'origine. Distinct de `CanalAgent` (web|whatsapp) qui ne sait pas
/// séparer le web classique du chat IA rendu dans le web.
enum CanalConsultation {
  web
  ia_web
  whatsapp

  @@map("canal_consultation")
}

/// Table INSERT-only. Aucune FK polymorphe (non supporté par Prisma) : l'intégrité
/// repose sur l'applicatif, comme `CentreEvent`. Aucune rétention/purge (décision PO
/// GUIC-688 : on conserve tout).
model Consultation {
  /// Identifiant de la consultation.
  id         BigInt            @id @default(autoincrement())
  /// Nature de l'entité consultée : opportunité, ressource, événement, centre, livre, programme, organisation.
  typeEntite EntiteConsultable @map("type_entite")
  /// Identifiant de l'entité consultée. Pas de clé étrangère : la relation est polymorphe et l'intégrité repose sur l'applicatif.
  entiteId   String            @map("entite_id") @db.VarChar(36)
  /// `impression` quand le contenu a été présenté, `consultation` quand il a été ouvert. Le rapport des deux donne le taux de clic.
  typeEvent  TypeConsultation  @map("type_event")
  /// Canal d'origine : `web`, `ia_web` pour l'agent Yaye sur le site, `whatsapp`.
  canal      CanalConsultation
  /// Null si visiteur anonyme.
  cjsUid     String?           @map("cjs_uid") @db.VarChar(36)
  /// HMAC-SHA256 du sujet (cjsUid, ou empreinte IP + user-agent). Jamais d'IP en clair en base. Masqué à l'export quand cjs_uid est renseigné.
  sujetHash  String            @map("sujet_hash") @db.Char(64)
  /// reco_ia | recherche | favoris | notification | direct | ia | wa
  origine    String?           @db.VarChar(30)
  /// Corrèle avec `AgentLog.sessionId` pour les canaux IA/WhatsApp.
  sessionId  String?           @map("session_id") @db.VarChar(36)
  /// Horodatage de la consultation. Table append-only : sert de watermark de réplication.
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([typeEntite, entiteId, createdAt])
  @@index([cjsUid, createdAt])
  @@index([canal, typeEvent, createdAt])
  @@index([createdAt, id])
  @@map("consultations")
}

// ─────────────────────────────────────────────
// M12 — IA : TRAÇABILITÉ AGENT YAYE (GUIC-259)
// Trace technique par événement (distincte de MessageWhatsApp = transcript,
// et de CentreEvent = KPI). Cf. .agent_context/specs/yaye/06-agent-logs-tracabilite.md
// ─────────────────────────────────────────────

enum CanalAgent {
  web
  whatsapp

  @@map("canal_agent")
}

enum StatutAgent {
  succes
  echec
  partiel

  @@map("statut_agent")
}

/// Types d'événements journalisés par Yaye (taxonomie spec §7.3).
enum TypeEvenementAgent {
  session_ouverte
  message_recu
  intention_detectee
  graph_interroge
  api_appelee
  reponse_generee
  badge_genere
  reservation_soumise
  emprunt_initie
  retour_enregistre
  contenu_transmis
  format_canal
  escalade_conseiller
  erreur

  @@map("type_evenement_agent")
}

/// Une ligne par action de Yaye, écrite au moment où elle se produit.
/// Une conversation de 10 échanges génère typiquement 40-60 lignes.
model AgentLog {
  id            String             @id @default(uuid()) @db.VarChar(36)
  sessionId     String             @map("session_id") @db.VarChar(36)
  cjsUid        String?            @map("cjs_uid") @db.VarChar(36)
  role          String?            @db.VarChar(40)
  centreId      String?            @map("centre_id") @db.VarChar(36)
  canal         CanalAgent
  tsMs          BigInt             @map("ts_ms") // horodatage epoch en millisecondes
  typeEvenement TypeEvenementAgent @map("type_evenement")
  toolCalled    String?            @map("tool_called") @db.VarChar(60)
  payload       Json? // message, paramètres, résultats — ⚠️ PII : minimisation + droit à l'oubli (doc 07/10)
  cypherQuery   String?            @map("cypher_query") @db.Text
  nodesReturned Json?              @map("nodes_returned")
  formatCanal   String?            @map("format_canal") @db.VarChar(40)
  dureeMs       Int?               @map("duree_ms")
  statut        StatutAgent        @default(succes)
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@index([cjsUid, createdAt(sort: Desc)])
  @@index([typeEvenement, createdAt])
  @@map("agent_logs")
}

/// Stade de traitement d'une escalade Yaye → conseiller humain (Lot 6).
enum StatutEscalade {
  en_attente // signalée, aucun conseiller ne l'a encore prise
  prise_en_charge // un conseiller s'en occupe
  resolue // traitée / clôturée

  @@map("statut_escalade")
}

/// File d'escalade Yaye → opérateur humain (Lot 6).
/// Une ligne est créée au moment où Yaye décide de passer la main à un conseiller.
/// La TRACE événementielle reste dans `agent_logs` (type `escalade_conseiller`) ;
/// ce modèle porte uniquement l'ÉTAT de traitement (statut + qui/quand), mutable
/// par le staff depuis le panel admin. On ne mute jamais `agent_logs` (append-only).
model EscaladeYaye {
  id        String         @id @default(uuid()) @db.VarChar(36)
  sessionId String         @map("session_id") @db.VarChar(36)
  cjsUid    String?        @map("cjs_uid") @db.VarChar(36) // utilisateur escaladé (null si non identifié)
  role      String?        @db.VarChar(40)
  centreId  String?        @map("centre_id") @db.VarChar(36)
  canal        CanalAgent
  raison       String?        @db.Text // pourquoi l'escalade — peut contenir des PII
  stade        String?        @db.VarChar(160) // stade de la conversation au moment de l'escalade
  signalDanger String?        @map("signal_danger") @db.VarChar(40) // catégorie de DANGER repérée (violence, harcelement…) — null sinon
  priorite     Int            @default(0) // 0 = normal · 1 = danger (remonte en haut de file)
  statut       StatutEscalade @default(en_attente)
  traitePar    String?        @map("traite_par") @db.VarChar(36) // cjs_uid du conseiller qui traite
  traiteA      DateTime?      @map("traite_a")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([statut, priorite, createdAt]) // tri file : statut, puis danger d'abord, puis ancienneté
  @@index([sessionId])
  @@index([centreId, statut])
  @@map("escalades_yaye")
}

// ───────────────────────────────────────────────────────────────────────────
// Métriques de performance conversationnelle Yaye (GUIC-435 — Yaye Quality Score)
// On AJOUTE, on ne modifie pas l'existant. Spec : 14-metriques-performance-conversationnelle.md
// ───────────────────────────────────────────────────────────────────────────

/// Feedback explicite de l'utilisateur (couche 5 — satisfaction). 👍 = +1, 👎 = -1.
/// `raison` peut contenir du texte libre (PII) → minimisation + droit à l'oubli.
model YayeFeedback {
  id        String     @id @default(uuid()) @db.VarChar(36)
  sessionId String     @map("session_id") @db.VarChar(36)
  cjsUid    String?    @map("cjs_uid") @db.VarChar(36)
  canal     CanalAgent
  tourIndex Int?       @map("tour_index") // tour visé dans la session (null = session globale)
  note      Int // +1 (👍) ou -1 (👎)
  raison    String?    @db.Text // optionnel, surtout sur 👎 — PII
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([cjsUid, createdAt(sort: Desc)])
  @@index([canal, createdAt])
  @@map("yaye_feedback")
}

/// Scores du juge LLM (couche 3 — qualité conversationnelle). 6 dimensions 0-1.
/// `tourIndex` null = note de la conversation entière. `drapeauRouge` = garde-fou levé.
model YayeEvalScore {
  id            String   @id @default(uuid()) @db.VarChar(36)
  sessionId     String   @map("session_id") @db.VarChar(36)
  tourIndex     Int?     @map("tour_index")
  juge          String   @db.VarChar(80) // modèle juge + version de rubric, ex "groq:llama-3.3-70b@rubric-v1"
  fidelite      Float // anti-hallucination — CRITIQUE (garde-fou)
  pertinence    Float
  utilite       Float
  persona       Float
  conformiteCdp Float    @map("conformite_cdp") // CRITIQUE (garde-fou)
  langue        Float
  drapeauRouge  Boolean  @default(false) @map("drapeau_rouge")
  commentaire   String?  @db.Text // justification courte du juge
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([createdAt])
  @@index([drapeauRouge, createdAt])
  @@map("yaye_eval_scores")
}

/// Transcript web durable (GUIC-435 — option A). Texte PSEUDONYMISÉ des tours web,
/// pour rendre les conversations web jugeables par le juge LLM (couche 3).
/// Écriture gardée par le flag d'env `YAYE_PERSIST_WEB_TRANSCRIPT` (défaut OFF).
/// ⚠️ CDP : texte pseudonymisé avant écriture + purge au droit à l'oubli (cascade cjs_uid).
model YayeTranscriptTurn {
  id            String     @id @default(uuid()) @db.VarChar(36)
  sessionId     String     @map("session_id") @db.VarChar(36)
  cjsUid        String?    @map("cjs_uid") @db.VarChar(36)
  canal         CanalAgent
  tourIndex     Int        @map("tour_index")
  userText      String?    @map("user_text") @db.Text // pseudonymisé
  assistantText String?    @map("assistant_text") @db.Text // pseudonymisé
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([sessionId, tourIndex])
  @@map("yaye_transcript_turns")
}

/// Rollup par session : 1 ligne / conversation (couches 1-2-4-5 agrégées + YQS composite).
/// Matérialisé par le service de rollups + le cron d'éval pour ne pas scanner agent_logs en live.
model YayeSessionSummary {
  id             String     @id @default(uuid()) @db.VarChar(36)
  sessionId      String     @unique @map("session_id") @db.VarChar(36)
  cjsUid         String?    @map("cjs_uid") @db.VarChar(36)
  centreId       String?    @map("centre_id") @db.VarChar(36)
  canal          CanalAgent
  nbTours        Int        @map("nb_tours")
  dureeMs        Int        @map("duree_ms")
  escalade       Boolean    @default(false)
  resolu         Boolean    @default(false)
  converti       Boolean    @default(false) // a produit une action métier (candidature/réservation)
  yqs            Float? // score composite 0-100 (null tant que non calculé)
  drapeauRouge   Boolean    @default(false) @map("drapeau_rouge")
  intentionPrinc String?    @map("intention_princ") @db.VarChar(60)
  calculeLe      DateTime   @default(now()) @map("calcule_le")

  @@index([canal, calculeLe])
  @@index([intentionPrinc])
  @@index([centreId, calculeLe])
  @@map("yaye_session_summaries")
}

/// Journal d'audit des actions sensibles (consultation PII, modération…) — traçabilité
/// CDP (loi sénégalaise 2008-12). Consulté par l'admin (/admin/journal-audit). Table
/// protégée (accès admin only) : stocke le `cjsUid` acteur EN CLAIR pour résoudre
/// l'identité dans la timeline. Rétention/anonymisation = raffinement DPO ultérieur.
/// Alimenté par src/lib/audit.ts (écriture fail-soft, jamais bloquante).
model AuditLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  actorCjsUid String   @map("actor_cjs_uid") @db.VarChar(36)
  action      String   @db.VarChar(64)
  targetType  String?  @map("target_type") @db.VarChar(40)
  targetId    String?  @map("target_id") @db.VarChar(64)
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorCjsUid])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// M4 — BIBLIOTHÈQUE PHYSIQUE DES CENTRES (Lot 3 Yaye, GUIC-274)
// Catalogue mutualisé · exemplaires localisés (rayon/étagère/position) ·
// emprunt « initié » en ligne → « en cours » au scan badge au centre · retour par scan.
// Spec : .agent_context/specs/M4-bibliotheque.md
// ─────────────────────────────────────────────

enum StatutExemplaire {
  disponible
  emprunte
  reserve
  indisponible

  @@map("statut_exemplaire")
}

enum StatutEmprunt {
  initie // créé en ligne (web/Yaye), pas encore retiré au centre
  en_cours // confirmé au scan badge au centre
  rendu // retourné (scan retour)
  en_retard // date de retour dépassée, non rendu
  annule // initié puis annulé (jeune ou expiration)

  @@map("statut_emprunt")
}

/// Livre du catalogue mutualisé (titre/auteur/ISBN/thème/niveau/langue/résumé). GUIC-341.
model Livre {
  id            String   @id @default(uuid()) @db.VarChar(36)
  titre         String   @db.VarChar(300)
  auteur        String   @db.VarChar(200)
  isbn          String?  @db.VarChar(20)
  theme         String   @db.VarChar(120)
  niveau        String?  @db.VarChar(60)
  langue        String   @default("fr") @db.VarChar(40)
  resume        String?  @db.Text
  couvertureUrl String?  @map("couverture_url") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  exemplaires Exemplaire[]

  @@index([titre])
  @@index([theme])
  @@index([isbn])
  @@map("livres")
}

/// Exemplaire physique individuellement identifié, localisé dans un centre. GUIC-341.
model Exemplaire {
  id        String           @id @default(uuid()) @db.VarChar(36)
  livreId   String           @map("livre_id") @db.VarChar(36)
  centreId  String           @map("centre_id") @db.VarChar(36)
  codeBarre String           @unique @map("code_barre") @db.VarChar(64)
  rayon     String           @db.VarChar(40)
  etagere   String           @db.VarChar(40)
  position  String           @db.VarChar(40)
  statut    StatutExemplaire @default(disponible)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  livre    Livre     @relation(fields: [livreId], references: [id], onDelete: Cascade)
  centre   Centre    @relation(fields: [centreId], references: [id])
  emprunts Emprunt[]

  @@index([livreId])
  @@index([centreId, statut])
  @@map("exemplaires")
}

/// Emprunt d'un exemplaire par un bénéficiaire. GUIC-343.
/// Cycle : initie (en ligne) → en_cours (scan badge au centre) → rendu (scan retour).
model Emprunt {
  /// Identifiant de l'emprunt.
  id               String        @id @default(uuid()) @db.VarChar(36)
  /// Jeune emprunteur — clé de jointure vers `utilisateurs`.
  cjsUid           String        @map("cjs_uid") @db.VarChar(36)
  /// Exemplaire physique emprunté, localisé dans un centre.
  exemplaireId     String        @map("exemplaire_id") @db.VarChar(36)
  /// `initie` en ligne, `en_cours` après retrait au centre, `rendu`, `en_retard`, ou `annule`.
  statut           StatutEmprunt @default(initie)
  /// Date de la demande d'emprunt en ligne.
  initieA          DateTime      @default(now()) @map("initie_a")
  /// Date du retrait effectif au centre, constaté au scan du badge.
  confirmeA        DateTime?     @map("confirme_a")
  confirmePar      String?       @map("confirme_par") @db.VarChar(36) // cjs_uid du bibliothécaire
  /// Date de retour attendue, fixée à la confirmation.
  dateRetourPrevue DateTime?     @map("date_retour_prevue")
  /// Date du retour effectif, constatée au scan.
  renduA           DateTime?     @map("rendu_a")
  /// Date de création de la ligne d'emprunt.
  createdAt        DateTime      @default(now()) @map("created_at")
  /// M13 — watermark de réplication Data Hub : le statut évolue (confirmation, retour)
  /// sans qu'aucune colonne ne datait la modification.
  updatedAt        DateTime      @updatedAt @map("updated_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid])
  exemplaire  Exemplaire  @relation(fields: [exemplaireId], references: [id])

  @@index([cjsUid, statut])
  @@index([exemplaireId, statut])
  @@index([statut, dateRetourPrevue])
  @@index([updatedAt, id])
  @@map("emprunts")
}

/// Configuration LLM pilotable depuis l'admin (GUIC-537). Singleton : une seule
/// ligne d'id "default". Un modèle Vertex par usage (agent Yaye / juge éval / scoring
/// adéquation). Le module memory suit le slot agent. Fallback env si la ligne est absente.
model LlmConfig {
  id              String   @id @default("default") @db.VarChar(36)
  agentModel      String   @map("agent_model") @db.VarChar(120)
  judgeModel      String   @map("judge_model") @db.VarChar(120)
  adequationModel String   @map("adequation_model") @db.VarChar(120)
  updatedBy       String?  @map("updated_by") @db.VarChar(36) // cjs_uid de l'admin
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("llm_config")
}

/// Curation automatisée d'opportunités (GUIC-595). Méthode d'extraction déterministe
/// SANS LLM, en cascade : `auto` essaie jsonld → rss → html_selecteurs → article_regex.
enum MethodeExtraction {
  auto
  jsonld
  rss
  api
  html_selecteurs
  article_regex

  @@map("methode_extraction")
}

enum FrequenceVeille {
  horaire
  six_heures
  quotidienne
  hebdomadaire

  @@map("frequence_veille")
}

/// Site-source surveillé par le robot de veille (GUIC-596, US-1).
/// `configExtraction` : sélecteurs CSS / paramètres API — requis pour les méthodes
/// `api` et `html_selecteurs` (invariant appliqué par la validation zod).
/// `prochaineVerifLe`/`derniereVerifLe` : pilotage du robot (US-2 GUIC-597) — le cron
/// horaire ne traite que les sources actives dues (`prochaineVerifLe <= now`).
model SourceVeille {
  id               String            @id @default(uuid()) @db.VarChar(36)
  nom              String            @db.VarChar(120)
  url              String            @unique @db.VarChar(500)
  methode          MethodeExtraction @default(auto)
  frequence        FrequenceVeille   @default(quotidienne)
  actif            Boolean           @default(true)
  configExtraction Json?             @map("config_extraction")
  typeDefautId     String?           @map("type_defaut_id") @db.VarChar(36)
  prochaineVerifLe DateTime?         @map("prochaine_verif_le")
  derniereVerifLe  DateTime?         @map("derniere_verif_le")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  typeDefaut OpportuniteType? @relation(fields: [typeDefautId], references: [id], onDelete: SetNull)

  executions ExecutionVeille[]
  items      ItemCuration[]

  @@index([actif, prochaineVerifLe])
  @@index([deletedAt])
  @@index([typeDefautId])
  @@map("sources_veille")
}

enum StatutExecution {
  ok
  partiel
  erreur

  @@map("statut_execution")
}

enum StatutItemCuration {
  decouvert
  a_valider
  approuvee
  rejetee
  en_attente
  doublon

  @@map("statut_item_curation")
}

/// Journal d'une exécution du robot de découverte sur une source (GUIC-597, US-2).
/// Alimente le monitoring US-7 (nb rapporté, erreurs, durée, dernière vérif).
model ExecutionVeille {
  id           String          @id @default(uuid()) @db.VarChar(36)
  sourceId     String          @map("source_id") @db.VarChar(36)
  demarreLe    DateTime        @map("demarre_le")
  dureeMs      Int             @map("duree_ms")
  nbLiensDecouverts Int        @default(0) @map("nb_liens_decouverts")
  nbNouveautes Int             @default(0) @map("nb_nouveautes")
  nbErreurs    Int             @default(0) @map("nb_erreurs")
  statut       StatutExecution
  messageErreur String?        @map("message_erreur") @db.Text
  createdAt    DateTime        @default(now()) @map("created_at")

  source SourceVeille   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  items  ItemCuration[]

  @@index([sourceId, createdAt])
  @@map("executions_veille")
}

/// Opportunité candidate détectée par le robot (GUIC-597, US-2 : statut `decouvert`).
/// `empreinte` = sha256 de l'URL canonique normalisée → dédup URL native (une URL déjà
/// vue n'est jamais resoumise). Les champs extraits/modération sont posés nullable et
/// remplis par les US suivantes (US-3 extraction, US-5 validation). `opportuniteId`
/// (US-6 publication) sera ajouté plus tard pour ne pas coupler `Opportunite` ici.
model ItemCuration {
  id             String             @id @default(uuid()) @db.VarChar(36)
  sourceId       String             @map("source_id") @db.VarChar(36)
  executionId    String?            @map("execution_id") @db.VarChar(36)
  urlCanonique   String             @map("url_canonique") @db.VarChar(500)
  empreinte      String             @unique @db.VarChar(64)
  titre          String?            @db.VarChar(300)
  payloadExtrait Json?              @map("payload_extrait")
  scoreCompletude Int?              @map("score_completude")
  nbTentatives   Int                @default(0) @map("nb_tentatives")
  // GUIC-599 — dédup CONTENU : sha256(titre+org normalisés). Distinct de `empreinte`
  // (clé URL). Indexé pour la recherche de doublon exact.
  empreinteContenu String?          @map("empreinte_contenu") @db.VarChar(64)
  doublonDeId    String?            @map("doublon_de_id") @db.VarChar(36)
  statut         StatutItemCuration @default(decouvert)
  motifRejet     String?            @map("motif_rejet") @db.Text
  modereePar     String?            @map("moderee_par") @db.VarChar(36)
  modereeLe      DateTime?          @map("moderee_le")
  // GUIC-601 — traçabilité : Opportunite créée à la publication (idempotence : non null = publié).
  opportuniteId  String?            @map("opportunite_id") @db.VarChar(36)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  source      SourceVeille     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  execution   ExecutionVeille? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  doublonDe   ItemCuration?    @relation("Doublons", fields: [doublonDeId], references: [id], onDelete: SetNull)
  doublons    ItemCuration[]   @relation("Doublons")
  opportunite Opportunite?     @relation("CurationPubliee", fields: [opportuniteId], references: [id], onDelete: SetNull)

  @@index([sourceId, statut])
  @@index([statut, createdAt])
  @@index([executionId])
  @@index([empreinteContenu])
  @@index([opportuniteId])
  @@map("items_curation")
}
