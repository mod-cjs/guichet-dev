generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────
// ÉNUMÉRATIONS
// ─────────────────────────────────────────────

enum Region {
  Dakar
  Thies
  Diourbel
  Fatick
  Kaolack
  Kaffrine
  Louga
  Saint_Louis
  Matam
  Tambacounda
  Kedougou
  Kolda
  Ziguinchor
  Sedhiou

  @@map("region")
}

enum Genre {
  M
  F

  @@map("genre")
}

// GUIC-660 — situation de handicap auto-déclarée (donnée socio-démographique inclusion).
/// GUIC-689 — Niveau de maîtrise d'une langue, du plus fort au plus faible.
/// Échelle volontairement courte : une auto-déclaration fine (A1..C2) serait
/// mal remplie et impossible à vérifier.
enum NiveauLangue {
  maternelle
  courant
  intermediaire
  notions

  @@map("niveau_langue")
}

/// GUIC-689 — Nature d'un élément du parcours, pour la timeline unifiée.
enum TypeParcours {
  formation
  experience
  engagement

  @@map("type_parcours")
}

enum Handicap {
  aucun
  moteur
  visuel
  auditif
  autre
  non_precise

  @@map("handicap")
}

// GUIC-660 — zone d'habitation auto-déclarée (rural / urbain).
enum ZoneHabitation {
  rural
  urbain

  @@map("zone_habitation")
}

enum StatutCompte {
  actif
  inactif
  anonymise

  @@map("statut_compte")
}

enum TypeOpportunite {
  Emploi
  Stage
  Formation
  Bourse
  Volontariat
  Appel_a_projets

  @@map("type_opportunite")
}

/// Type de contrat employé sur OpportuniteEmploi (GUIC-183 / 178b).
enum TypeContrat {
  CDI
  CDD
  FREELANCE
  ALTERNANCE
  STAGE_ALTERNE

  @@map("type_contrat")
}

/// Modalité pédagogique sur OpportuniteFormation (GUIC-183 / 178b).
enum ModaliteFormation {
  PRESENTIEL
  DISTANCE
  HYBRIDE

  @@map("modalite_formation")
}

/// Niveau d'études minimum requis (GUIC-183 / 178b).
/// Décision Q8 spec §18 : enum strict (override DP6 String libre).
enum NiveauEtudes {
  BFEM
  BAC
  BAC_PLUS_2
  BAC_PLUS_3
  BAC_PLUS_5
  DOCTORAT

  @@map("niveau_etudes")
}

/// Type de financement (GUIC-183 / 178b post-audit — spec §19).
enum TypeFinancement {
  MICROCREDIT
  SUBVENTION
  DOTATION
  PRET_HONNEUR
  CAPITAL_AMORCAGE

  @@map("type_financement")
}

/// Modalité de mentorat (GUIC-183 / 178b post-audit — spec §19).
enum ModaliteMentorat {
  INDIVIDUEL
  GROUPE
  COHORTE

  @@map("modalite_mentorat")
}

/// Type de mobilité (GUIC-183 / 178b post-audit — spec §19).
enum TypeMobilite {
  ETUDE
  STAGE
  PROFESSIONNELLE
  RECHERCHE

  @@map("type_mobilite")
}

/// Type de volontariat (GUIC-183 / 178b post-audit — spec §19).
enum TypeVolontariat {
  SERVICE_CIVIQUE
  ENGAGEMENT
  INTERNATIONAL
  HUMANITAIRE

  @@map("type_volontariat")
}

/// Taxonomie des domaines — refonte PO du 2026-08-17 : neuf valeurs deviennent six.
/// Vocabulaire, libellés et correspondance : `src/lib/domaines.ts` (source unique).
enum Domaine {
  BienEtre
  Citoyennete
  Culture
  Ecologie
  Economie
  Employabilite
  /// Repli TECHNIQUE, jamais proposé à l'utilisateur : `domaineOuAutre()` s'en
  /// sert quand la curation extrait un domaine non reconnu. Le supprimer ferait
  /// échouer la publication d'un item mal étiqueté.
  Autre

  @@map("domaine")
}

enum StatutOpportunite {
  brouillon
  publiee
  archivee
  expiree

  @@map("statut_opportunite")
}

enum StatutCandidature {
  En_attente
  Vue
  Retenue
  Refusee
  // GUIC-689 — retrait à l'initiative du CANDIDAT. État terminal : la ligne est
  // conservée (traçabilité, et la contrainte d'unicité `[cjsUid, opportuniteId]`
  // rend de fait la re-candidature impossible — le retrait est annoncé comme
  // irréversible à l'utilisateur). Distinct de `Refusee`, qui est une décision
  // du recruteur : les confondre fausserait les statistiques des deux côtés.
  Retiree

  @@map("statut_candidature")
}

/// GUIC-515 — étapes du pipeline recruteur (kanban, design v4 Lot 10).
enum StatutPipeline {
  Recue
  Preselection
  Entretien
  Decision

  @@map("statut_pipeline")
}

enum TypeEvenement {
  Formation
  Atelier
  Forum
  Webinar
  Conference
  Cours // GUIC-474 — cours/sessions gratuites au centre (présence par badge)

  @@map("type_evenement")
}

enum StatutEvenement {
  a_venir
  en_cours
  termine
  annule
  en_relecture // GUIC-477 — en attente de validation admin
  refuse       // GUIC-477 — refusée par l'admin

  @@map("statut_evenement")
}

enum TypeRessource {
  PDF
  Video
  Lien
  Guide
  Outil

  @@map("type_ressource")
}

// GUIC-24 — niveau de difficulté pour filtrer la bibliothèque.
enum NiveauRessource {
  Debutant
  Intermediaire
  Avance

  @@map("niveau_ressource")
}

// GUIC-24 — langue de la ressource (étendre si besoin).
enum LangueRessource {
  FR
  Wolof

  @@map("langue_ressource")
}

enum StatutInscription {
  inscrit
  liste_attente
  annule
  present

  @@map("statut_inscription")
}

enum RoleAgent {
  conseiller
  directeur
  admin_centre

  @@map("role_agent")
}

/// Types de notifications (M11 — GUIC-247).
enum TypeNotification {
  Deadline
  Candidature
  Message
  Yaye
  System

  @@map("type_notification")
}

// ─────────────────────────────────────────────
// M1 — SOCLE : UTILISATEURS & PROFILS
// ─────────────────────────────────────────────

// Identité de base — synchronisée depuis le SSO via webhook user.*
// Ne jamais modifier directement : la source de vérité est le SSO CJS
/// Compte issu du SSO CJS. Aucun mot de passe n'est stocké ici : l'authentification appartient au SSO, ce modèle n'en cache que l'identité et les attributs de profilage.
model Utilisateur {
  /// Claim `sub` du token SSO — identifiant pivot du jeune dans tout l'écosystème CJS, et seule clé de jointure inter-plateformes.
  cjsUid             String       @id @map("cjs_uid") @db.VarChar(36)
  telephone          String?      @unique @db.VarChar(20)
  email              String?      @unique @db.VarChar(255)
  nom                String       @db.VarChar(100)
  prenom             String       @db.VarChar(100)
  /// Région administrative de résidence, parmi les 14 du Sénégal.
  region             Region?
  /// Genre déclaré : `M` ou `F`.
  genre              Genre?
  /// Date de naissance déclarée. Donnée identifiante : n'est jamais exportée telle quelle, uniquement sous forme de tranche d'âge.
  dateNaissance      DateTime?    @map("date_naissance")
  /// État du compte : `actif`, `inactif`, ou `anonymise` après exercice du droit à l'oubli.
  statut             StatutCompte @default(actif)
  /// Rôle principal mis en cache depuis le SSO (source de vérité = SSO ; synchronisé au login).
  role               String?      @db.VarChar(40)
  /// GUIC-689 — Matricule de membre CJS, imprimé sur la carte.
  ///
  /// Format `GJ-<année d'inscription>-<5 chiffres><lettre de contrôle>`, repris
  /// de la maquette (`cjs-card.jsx`). C'est un identifiant PUBLIC, lisible et
  /// dictable au comptoir — à la différence de `cjsUid`, qui est l'identifiant
  /// technique inter-plateformes et n'a pas vocation à être affiché.
  ///
  /// Nullable : les comptes migrés n'en ont pas tant que le backfill n'est pas
  /// passé, et un compte sans matricule doit rester utilisable.
  matricule          String?      @unique @db.VarChar(20)
  /// Commune de résidence, saisie libre à l'onboarding — non normalisée.
  commune            String?      @db.VarChar(100)
  /// Le parcours d'onboarding a été mené à son terme. Distingue un compte créé d'un compte réellement activé.
  onboardingComplete Boolean      @default(false) @map("onboarding_complete")
  // GUIC-513 — préférences de notification recruteur (Paramètres). Défaut : activées.
  notifCandidatures  Boolean      @default(true) @map("notif_candidatures")
  notifMessages      Boolean      @default(true) @map("notif_messages")
  drupalUid          Int?         @unique @map("drupal_uid")
  /// Date de création du compte — sert de date d'inscription dans les indicateurs.
  createdAt          DateTime     @default(now()) @map("created_at")
  /// Dernière modification du compte. Watermark de réplication Data Hub.
  updatedAt          DateTime     @updatedAt @map("updated_at")
  /// Suppression logique. Non nulle, la ligne reste exportée avec cette date pour que l'entrepôt propage la suppression au lieu de conserver un fantôme.
  deletedAt          DateTime?    @map("deleted_at")

  profil                ProfilJeune?
  candidatures          Candidature[]
  candidatureDrafts     CandidatureDraft[]
  inscriptions          InscriptionEvenement[]
  ressourcesFavoris     RessourceFavorite[]
  opportunitesFavorites OpportuniteFavorite[]
  conversations         ConversationWhatsApp[]
  recommandations       RecommandationIA[]
  notifications         Notification[]
  notifPreferences      NotificationPreference[]
  notifEnvois           NotificationEnvoi[]
  // Lot 7 — Centres CJS (GUIC-350)
  reservations          Reservation[]
  checkIns              CheckIn[]
  // M8 admin (GUIC-469) — suivi des insertions professionnelles
  insertions            Insertion[]
  // Lot 3 — Bibliothèque physique (GUIC-274)
  emprunts              Emprunt[]

  @@index([email])
  @@index([telephone])
  @@index([statut])
  @@index([role])
  @@index([updatedAt, cjsUid])
  @@map("utilisateurs")
}

// Profil enrichi — rempli par le jeune après inscription
/// Profil bénéficiaire, rattaché 1:1 à un compte. Porte les données déclaratives d'orientation et d'inclusion, toutes facultatives et auto-déclarées.
model ProfilJeune {
  /// Identifiant technique du profil, distinct du `cjs_uid` du compte porteur.
  id                String    @id @default(uuid()) @db.VarChar(36)
  /// Compte porteur du profil — clé de jointure vers `utilisateurs`.
  cjsUid            String    @unique @map("cjs_uid") @db.VarChar(36)
  photoUrl          String?   @map("photo_url") @db.VarChar(500)
  biographie        String?   @db.Text
  // JSON arrays stockés en texte — ex: ["JavaScript","Python"] ou ["Agriculture","Numérique"]
  competences       Json?
  domainesInteret   Json?     @map("domaines_interet")
  /// Niveau d'études le plus élevé atteint, déclaré par le jeune.
  niveauEtude       String?   @map("niveau_etude") @db.VarChar(50)
  /// Situation professionnelle déclarée au moment de la dernière mise à jour du profil.
  situationEmploi   String?   @map("situation_emploi") @db.VarChar(50)
  // GUIC-660 — données socio-démographiques inclusion (auto-déclarées, facultatives,
  // hors score de complétion). Voir .agent_context/specs/GUIC-660-profil-handicap-zone.md
  /// Situation de handicap auto-déclarée : `aucun`, `moteur`, `visuel`, `auditif`, `autre`, `non_precise`. Facultative et hors score de complétion (GUIC-660).
  situationHandicap Handicap?       @map("situation_handicap")
  /// Zone d'habitation auto-déclarée : `rural` ou `urbain`. Facultative (GUIC-660).
  zoneHabitation    ZoneHabitation? @map("zone_habitation")
  /// Score 0–100 calculé et mis à jour dans ProfilService.recalculerScore()
  completionScore   Int       @default(0) @map("completion_score")
  profileVisibility String    @default("public") @map("profile_visibility") @db.VarChar(20)
  // CV stocké (GUIC-223 / GUIC-224) — réutilisable depuis CandidatureModal
  cvUrl             String?   @map("cv_url") @db.VarChar(500)
  cvUploadedAt      DateTime? @map("cv_uploaded_at")
  // GUIC-689 — « Objectif & secteurs visés » (réf profil-web.jsx ObjectiveCard).
  // `domainesInteret` portait déjà les secteurs (alimenté par l'onboarding) ;
  // ces trois champs complètent la carte.
  /// Objectif exprimé librement par le jeune (« lancer une micro-entreprise… »).
  objectif          String?   @db.Text
  /// Types d'opportunité recherchés — JSON, ex. ["financement","formation"].
  typesRecherches   Json?     @map("types_recherches")
  /// Régions où le jeune accepte de se déplacer — JSON, ex. ["Tambacounda"].
  regionsMobilite   Json?     @map("regions_mobilite")
  // GUIC-581 — Préférences d'accessibilité (page /jeune/accessibilite).
  // Shape { text, contrast, gray, motion, spacing, falc, kbd } — validé par Zod
  // dans l'action modifierPrefsAccessibilite ; cache localStorage côté client.
  prefsAccessibilite Json?    @map("prefs_accessibilite")
  /// Date de création du profil.
  createdAt         DateTime  @default(now()) @map("created_at")
  /// Dernière modification du profil. Watermark de réplication Data Hub.
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Lot 7 — Centre de rattachement principal (GUIC-350, ADR centre principal hybride)
  // Renseigné à l'onboarding via auto-suggest par région SSO, modifiable ensuite.
  /// Centre de rattachement principal, suggéré à l'onboarding depuis la région SSO puis modifiable.
  centrePrincipalId String? @map("centre_principal_id") @db.VarChar(36)

  utilisateur     Utilisateur        @relation(fields: [cjsUid], references: [cjsUid])
  experiences     Experience[]
  diplomes        Diplome[]
  certificats     CertificatMoodle[]
  langues         LangueProfil[]
  engagements     Engagement[]
  centrePrincipal Centre?            @relation("ProfilCentrePrincipal", fields: [centrePrincipalId], references: [id])

  @@index([centrePrincipalId])
  @@index([updatedAt, id])
  @@map("profils_jeunes")
}

// Expériences professionnelles du jeune
/// GUIC-689 — Langue déclarée par le jeune, avec son niveau (carte
/// « Compétences & langues »). Une ligne par langue : les langues comptent dans
/// le matching au Sénégal (wolof, français, pulaar, sérère…), un champ texte
/// libre ne s'exploiterait pas.
model LangueProfil {
  id       String       @id @default(uuid()) @db.VarChar(36)
  profilId String       @map("profil_id") @db.VarChar(36)
  /// Nom de la langue tel que saisi/choisi (« Wolof », « Français »).
  langue   String       @db.VarChar(60)
  niveau   NiveauLangue

  profil ProfilJeune @relation(fields: [profilId], references: [id], onDelete: Cascade)

  /// Une même langue ne peut être déclarée deux fois par le même profil.
  @@unique([profilId, langue])
  @@index([profilId])
  @@map("langues_profil")
}

/// GUIC-689 — Engagement associatif / bénévolat / volontariat.
///
/// Troisième source de la timeline unifiée, aux côtés des expériences
/// (`Experience`) et des formations (`Diplome`). Ce type n'existait pas : le
/// bénévolat était soit absent, soit saisi comme une expérience professionnelle,
/// ce qui fausse la lecture d'un parcours.
model Engagement {
  id           String    @id @default(uuid()) @db.VarChar(36)
  profilId     String    @map("profil_id") @db.VarChar(36)
  /// Rôle tenu (« Bénévole sensibilisation »).
  role         String    @db.VarChar(150)
  organisation String    @db.VarChar(150)
  dateDebut    DateTime  @map("date_debut")
  /// Nul = engagement toujours en cours.
  dateFin      DateTime? @map("date_fin")
  description  String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  profil ProfilJeune @relation(fields: [profilId], references: [id], onDelete: Cascade)

  @@index([profilId])
  @@map("engagements")
}

model Experience {
  id           String    @id @default(uuid()) @db.VarChar(36)
  profilId     String    @map("profil_id") @db.VarChar(36)
  poste        String    @db.VarChar(150)
  organisation String    @db.VarChar(150)
  dateDebut    DateTime  @map("date_debut")
  dateFin      DateTime? @map("date_fin")
  description  String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  profil ProfilJeune @relation(fields: [profilId], references: [id], onDelete: Cascade)

  @@index([profilId])
  @@map("experiences")
}

// Diplômes du jeune (GUIC-19) — remplace l'ancienne colonne Json `diplomes`
model Diplome {
  id             String   @id @default(uuid()) @db.VarChar(36)
  profilId       String   @map("profil_id") @db.VarChar(36)
  intitule       String   @db.VarChar(200)
  etablissement  String   @db.VarChar(200)
  anneeObtention Int      @map("annee_obtention")
  niveau         String   @db.VarChar(50)
  mention        String?  @db.VarChar(50)
  // GUIC-360 — scan justificatif (PDF/JPG/PNG) uploadé sur Vercel Blob.
  fichierUrl     String?  @map("fichier_url") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  profil ProfilJeune @relation(fields: [profilId], references: [id], onDelete: Cascade)

  @@index([profilId])
  @@map("diplomes")
}

// ─────────────────────────────────────────────
// M2 — ORGANISATION RECRUTEUR
// ─────────────────────────────────────────────

model Organisation {
  id         String   @id @default(uuid()) @db.VarChar(36)
  cjsUid     String   @map("cjs_uid") @db.VarChar(36)
  nom        String   @db.VarChar(200)
  description String?  @db.Text // GUIC-510 — présentation du partenaire (affichée admin/recruteur)
  secteur    Domaine?
  region     Region?
  adresse    String?  @db.VarChar(300)
  telephone  String?  @db.VarChar(20)
  email      String?  @db.VarChar(255)
  siteWeb    String?  @map("site_web") @db.VarChar(500)
  logoUrl    String?  @map("logo_url") @db.VarChar(500)
  estVerifie Boolean  @default(false) @map("est_verifie")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  opportunites Opportunite[]
  programmes   OrganisationProgramme[]

  @@index([cjsUid])
  @@map("organisations")
}

// ─────────────────────────────────────────────
// M3 — OPPORTUNITÉS & CANDIDATURES
// ─────────────────────────────────────────────

/// Table mère M3 v2 (CTI). Colonnes legacy (type, organisation) conservées
/// pendant la migration data — supprimées en 178d après backfill.
/// Les colonnes polymorphiques (typeId, programmeId, organisationId déjà présent,
/// organisationLibelle, niveauEtudeMin) sont ajoutées en NULL dans cette étape (178b)
/// pour ne pas casser les rows existantes ; elles passent NOT NULL en 178d.
/// L'invariant XOR (1 et 1 seul sous-type non null) est garanti côté applicatif
/// via OpportuniteService — cf. spec §8.4 et `opportunite-integrity.ts`.
model Opportunite {
  /// Identifiant de l'opportunité.
  id          String @id @default(uuid()) @db.VarChar(36)
  drupalNid   Int?   @unique @map("drupal_nid")
  /// Identifiant lisible utilisé dans l'URL publique.
  slug        String @unique @db.VarChar(280)
  /// Intitulé de l'offre tel qu'affiché au public.
  titre       String @db.VarChar(255)
  description String @db.LongText

  // Sections structurées (GUIC-257) — affichage avec h2 + paragraphes.
  // Nullable : rétro-compatible, fallback sur description plate si absentes.
  profilRecherche String? @map("profil_recherche") @db.Text
  mission         String? @db.Text
  conditions      String? @db.Text

  // Champs legacy — conservés jusqu'en 178d (drop après backfill)
  /// Type historique de l'offre (enum legacy). Conservé le temps de la migration polymorphique ; `type_id` est la forme cible.
  type         TypeOpportunite
  organisation String          @db.VarChar(200)

  // Nouveaux champs polymorphiques (nullable durant migration data — 178b/c)
  /// Type de l'offre dans le référentiel polymorphique. Nullable tant que la migration des données legacy n'est pas achevée.
  typeId              String?       @map("type_id") @db.VarChar(36)
  /// Nom de l'organisation émettrice tel qu'affiché, y compris quand elle n'est pas au référentiel.
  organisationLibelle String?       @map("organisation_libelle") @db.VarChar(200)
  /// Niveau d'études minimum requis, tel que renseigné par l'émetteur.
  niveauEtudeMin      NiveauEtudes? @map("niveau_etude_min")

  /// Secteur d'activité : agriculture, numérique, entrepreneuriat, citoyenneté, environnement, santé, éducation, culture, autre.
  domaine        Domaine
  /// Région ciblée par l'offre — pas nécessairement celle du candidat.
  region         Region?
  /// Organisation émettrice dans le référentiel. Nullable pour les offres importées sans organisation identifiée.
  organisationId String?           @map("organisation_id") @db.VarChar(36)
  /// Rémunération annoncée, en texte libre — non normalisée, non comparable entre offres.
  remuneration   String?           @db.VarChar(100)
  /// Date limite de candidature. Au-delà, l'offre passe en `expiree`.
  deadline       DateTime?
  lienExterne    String?           @map("lien_externe") @db.VarChar(500)
  /// Cycle de vie éditorial : `brouillon`, `publiee`, `archivee`, `expiree`.
  statut         StatutOpportunite @default(brouillon)
  /// Recruteur propriétaire de l'offre, quand elle a été déposée depuis l'espace recruteur.
  recruteurUid   String?           @map("recruteur_uid") @db.VarChar(36)

  // Traçabilité de modération (GUIC-471 — édition/publication directe admin, conformité CDP).
  // Générique : `moderePar`/`modereLe` renseignés à l'approbation OU au rejet ;
  // `motifRejet` uniquement au rejet. Tous nullable → rétro-compatible (rows existantes).
  motifRejet String?   @map("motif_rejet") @db.Text
  moderePar  String?   @map("modere_par") @db.VarChar(36)
  modereLe   DateTime? @map("modere_le")

  /// Compteur cumulé d'affichages du détail. Incrémenté en direct, sans déduplication par visiteur.
  vues           Int               @default(0)
  /// Date de création de l'offre.
  createdAt      DateTime          @default(now()) @map("created_at")
  /// Dernière modification de l'offre. Watermark de réplication Data Hub.
  updatedAt      DateTime          @updatedAt @map("updated_at")
  /// Suppression logique. Non nulle, la ligne reste exportée pour que l'entrepôt propage la suppression.
  deletedAt      DateTime?         @map("deleted_at")

  org       Organisation?    @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  typeRef   OpportuniteType? @relation(fields: [typeId], references: [id])

  // Sous-types 1:1 (un seul des dix non-null — invariant applicatif)
  // Spec §19 — 4 sous-types ajoutés post-audit guichetjeunesse.sn (2026-06-01)
  emploi        OpportuniteEmploi?
  stage         OpportuniteStage?
  formation     OpportuniteFormation?
  bourse        OpportuniteBourse?
  concours      OpportuniteConcours?
  appelAProjets OpportuniteAppelAProjets?
  financement   OpportuniteFinancement?
  mentorat      OpportuniteMentorat?
  mobilite      OpportuniteMobilite?
  volontariat   OpportuniteVolontariat?

  skills       OpportuniteSkill[]
  tags         OpportuniteTag[]
  programmes   OpportuniteProgramme[]
  candidatures Candidature[]
  drafts       CandidatureDraft[]
  favoris      OpportuniteFavorite[]
  itemsCuration ItemCuration[]      @relation("CurationPubliee")

  @@index([statut, deletedAt])
  @@index([type, domaine])
  @@index([typeId, domaine])
  @@index([region])
  @@index([deadline])
  @@fulltext([titre, description])
  @@index([updatedAt, id])
  @@map("opportunites")
}

/// Candidature d'un jeune à une opportunité, unique par couple (jeune, opportunité). Porte la traçabilité du consentement CGU exigée par la CDP.
model Candidature {
  /// Identifiant de la candidature.
  id                   String            @id @default(uuid()) @db.VarChar(36)
  /// Jeune candidat — clé de jointure vers `utilisateurs`.
  cjsUid               String            @map("cjs_uid") @db.VarChar(36)
  /// Offre visée — clé de jointure vers `opportunites`.
  opportuniteId        String            @map("opportunite_id") @db.VarChar(36)
  /// Décision côté offre : `En_attente`, `Vue`, `Retenue`, `Refusee`.
  statut               StatutCandidature @default(En_attente)
  lettreMotivation     String?           @map("lettre_motivation") @db.Text
  cvUrl                String?           @map("cv_url") @db.VarChar(500)
  // GUIC-361 — snapshot des données saisies au moment de la candidature
  // (email, téléphone, niveau d'études, situation, compétences…). Permet de
  // figer ce qui a été transmis au recruteur, indépendamment des évolutions
  // ultérieures du profil.
  formulaireData       Json?             @map("formulaire_data")
  /// Le candidat a accepté d'être notifié du suivi de sa candidature.
  notificationsConsent Boolean           @default(false) @map("notifications_consent")
  // Traçabilité du consentement CGU (GUIC-218 / audit CDP).
  /// Horodatage de l'acceptation des CGU. Traçabilité exigée par l'audit CDP.
  consentAt            DateTime?         @map("consent_at")
  /// Version des CGU acceptée, pour savoir à quel texte le consentement se rapporte.
  cguVersion           String?           @map("cgu_version") @db.VarChar(20)
  consentIp            String?           @map("consent_ip") @db.VarChar(45)
  // GUIC-487 (US-5) — score d'adéquation candidat/offre (IA Groq), 0–100. Nullable :
  // calculé en tâche de fond après soumission ; `null` tant que non calculé.
  /// Score d'adéquation candidat/offre calculé par IA, de 0 à 100. Nul tant que le calcul de fond n'a pas eu lieu.
  scoreAdequation      Int?              @map("score_adequation")
  scoreRaison          String?           @map("score_raison") @db.Text
  /// Date du calcul du score d'adéquation. Permet de distinguer un score absent d'un score jamais calculé.
  scoreCalculeLe       DateTime?         @map("score_calcule_le")
  // GUIC-515 — étape du pipeline recruteur (kanban, design v4) + favori recruteur.
  /// Étape du pipeline recruteur : `Recue`, `Preselection`, `Entretien`, `Decision`. Distincte du statut, qui porte la décision finale.
  pipelineStage        StatutPipeline    @default(Recue) @map("pipeline_stage")
  /// Candidature marquée comme favorite par le recruteur.
  favoriRecruteur      Boolean           @default(false) @map("favori_recruteur")
  /// Date de soumission de la candidature — début du délai de traitement.
  soumiseA             DateTime          @default(now()) @map("soumise_a")
  /// Dernière modification. Watermark de réplication Data Hub.
  updatedAt            DateTime          @updatedAt @map("updated_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid], onDelete: Cascade)
  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)
  conversation Conversation?
  entretiens   Entretien[]

  @@unique([cjsUid, opportuniteId])
  @@index([statut])
  @@index([opportuniteId])
  @@index([updatedAt, id])
  @@map("candidatures")
}

enum ModeEntretien {
  Presentiel
  Visio
  Telephone

  @@map("mode_entretien")
}

enum StatutEntretien {
  Planifie
  Annule
  Termine

  @@map("statut_entretien")
}

/// GUIC-514 — Entretien planifié par le recruteur pour une candidature.
model Entretien {
  id            String          @id @default(uuid()) @db.VarChar(36)
  candidatureId String          @map("candidature_id") @db.VarChar(36)
  recruteurUid  String          @map("recruteur_uid") @db.VarChar(36)
  candidatUid   String          @map("candidat_uid") @db.VarChar(36)
  dateHeure     DateTime        @map("date_heure")
  mode          ModeEntretien   @default(Visio)
  lieu          String?         @db.VarChar(500) // adresse (présentiel) ou lien (visio)
  notes         String?         @db.Text
  statut        StatutEntretien @default(Planifie)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  candidature Candidature @relation(fields: [candidatureId], references: [id], onDelete: Cascade)

  @@index([recruteurUid, dateHeure])
  @@index([candidatUid, dateHeure])
  @@index([candidatureId])
  @@map("entretiens")
}

/// GUIC-132/133 — Messagerie interne recruteur ↔ candidat, ancrée à une candidature.
/// Le consentement CDP est implicite : le jeune a postulé à l'offre du recruteur.
model Conversation {
  id            String   @id @default(uuid()) @db.VarChar(36)
  // GUIC-470 — nullable : conversations conseiller<->beneficiaire sans candidature.
  candidatureId String?  @unique @map("candidature_id") @db.VarChar(36)
  /// Sujet libre pour les conversations sans candidature (ex. Accompagnement).
  sujet         String?  @db.VarChar(255)
  recruteurUid  String   @map("recruteur_uid") @db.VarChar(36)
  candidatUid   String   @map("candidat_uid") @db.VarChar(36)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at") // = date du dernier message (tri inbox)

  candidature Candidature? @relation(fields: [candidatureId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([recruteurUid, updatedAt(sort: Desc)])
  @@index([candidatUid, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid()) @db.VarChar(36)
  conversationId String    @map("conversation_id") @db.VarChar(36)
  senderUid      String    @map("sender_uid") @db.VarChar(36)
  corps          String    @db.Text
  lu             Boolean   @default(false) // lu par le destinataire (non-sender)
  luLe           DateTime? @map("lu_le")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

/**
 * Brouillon de candidature — GUIC-382 V2.
 * Permet au jeune de quitter le formulaire en cours et de le reprendre depuis
 * un autre appareil. Auto-sauvegarde côté serveur (debounce 2 s). Supprimé
 * automatiquement à la soumission. TTL recommandé : 30 jours (cron cleanup).
 * Un seul draft par (cjsUid, opportuniteId).
 */
model CandidatureDraft {
  cjsUid        String   @map("cjs_uid") @db.VarChar(36)
  opportuniteId String   @map("opportunite_id") @db.VarChar(36)
  lettre        String?  @db.Text
  cvUrl         String?  @map("cv_url") @db.VarChar(500)
  consent       Boolean  @default(false)
  cvMode        String   @default("upload") @map("cv_mode") @db.VarChar(20)
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid], onDelete: Cascade)
  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@id([cjsUid, opportuniteId])
  @@index([cjsUid])
  @@index([updatedAt])
  @@map("candidature_drafts")
}

// Favori d'opportunité — aligné sur le pattern RessourceFavorite (clé composite, pas de uuid).
model OpportuniteFavorite {
  cjsUid        String   @map("cjs_uid") @db.VarChar(36)
  opportuniteId String   @map("opportunite_id") @db.VarChar(36)
  createdAt     DateTime @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid], onDelete: Cascade)
  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@id([cjsUid, opportuniteId])
  @@index([cjsUid])
  @@map("opportunites_favorites")
}

// ─────────────────────────────────────────────
// M4 — CENTRES CJS
// ─────────────────────────────────────────────

/// Centre CJS physique. Référentiel géographique de toute la fréquentation : réservations, passages badgés, emprunts.
model Centre {
  /// Identifiant du centre.
  id          String   @id @default(uuid()) @db.VarChar(36)
  /// Nom du centre — désigne l'établissement, jamais une personne.
  nom         String   @db.VarChar(200)
  /// Région d'implantation.
  region      Region
  /// Adresse postale du centre. Donnée d'établissement, publiée sur la fiche.
  adresse     String   @db.VarChar(300)
  /// Latitude du centre, pour la carte et les calculs de proximité.
  latitude    Float
  /// Longitude du centre.
  longitude   Float
  telephone   String   @db.VarChar(20)
  responsable String   @db.VarChar(150)
  /// Identifiant du centre dans la plateforme Gestion Centres — clé de rapprochement inter-plateformes.
  gcId        Int?     @unique @map("gc_id")
  /// Centre ouvert au public. Un centre inactif reste référencé mais n'accepte plus de réservation.
  estActif    Boolean  @default(true) @map("est_actif")
  /// Date de création de la fiche.
  createdAt   DateTime @default(now()) @map("created_at")
  /// Dernière modification. Watermark de réplication Data Hub.
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Lot 7 — Centres CJS (GUIC-350)
  /// Identifiant lisible utilisé dans l'URL publique.
  slug             String? @unique @db.VarChar(120)
  description      String? @db.Text
  imageUrl         String? @map("image_url") @db.VarChar(500)
  email            String? @db.VarChar(255)
  /// Ville d'implantation.
  ville            String? @db.VarChar(120)
  // JSON string[] de valeurs CentreService (cf enum) — Json pour flexibilité
  services         Json    @default("[]")
  /// Nombre de conseillers affectés, saisi et non calculé.
  conseillersCount Int     @default(0) @map("conseillers_count")

  evenements       Evenement[]
  agents           AgentCentre[]
  horaires         CentreHoraire[]
  ressources       RessourceCentre[]
  reservations     Reservation[]
  checkIns         CheckIn[]
  events           CentreEvent[]
  profilsRattaches ProfilJeune[]     @relation("ProfilCentrePrincipal")
  insertions       Insertion[]
  // Lot 3 — Bibliothèque physique (GUIC-274) : exemplaires localisés dans ce centre
  exemplaires      Exemplaire[]
  programmes       CentreProgramme[]

  @@index([region])
  @@index([slug])
  @@index([updatedAt, id])
  @@map("centres")
}

/// Insertion professionnelle d'un jeune (emploi/stage/formation) — base du taux d'insertion (GUIC-469).
model Insertion {
  id            String   @id @default(uuid()) @db.VarChar(36)
  cjsUid        String   @map("cjs_uid") @db.VarChar(36)
  opportuniteId String?  @map("opportunite_id") @db.VarChar(36)
  centreId      String?  @map("centre_id") @db.VarChar(36)
  type          String?  @db.VarChar(50)
  dateInsertion DateTime @default(now()) @map("date_insertion")
  createdAt     DateTime @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid])
  centre      Centre?     @relation(fields: [centreId], references: [id])

  @@index([cjsUid])
  @@index([centreId])
  @@index([dateInsertion])
  @@map("insertions")
}

model AgentCentre {
  id        String    @id @default(uuid()) @db.VarChar(36)
  cjsUid    String    @map("cjs_uid") @db.VarChar(36)
  centreId  String    @map("centre_id") @db.VarChar(36)
  role      RoleAgent @default(conseiller)
  createdAt DateTime  @default(now()) @map("created_at")

  centre Centre @relation(fields: [centreId], references: [id])

  @@unique([cjsUid, centreId])
  @@map("agents_centres")
}

// ─────────────────────────────────────────────
// M5 — AGENDA / ÉVÉNEMENTS
// ─────────────────────────────────────────────

/// Événement du calendrier CJS — formation, atelier, forum, webinaire, conférence ou cours en centre.
model Evenement {
  /// Identifiant de l'événement.
  id           String          @id @default(uuid()) @db.VarChar(36)
  drupalNid    Int?            @unique @map("drupal_nid")
  /// Intitulé de l'événement tel qu'affiché.
  titre        String          @db.VarChar(255)
  description  String          @db.Text
  /// Nature de l'événement : formation, atelier, forum, webinaire, conférence, cours.
  type         TypeEvenement
  /// Cycle de vie : `a_venir`, `en_cours`, `termine`, `annule`, plus `en_relecture` et `refuse` pour la validation admin.
  statut       StatutEvenement @default(a_venir)
  /// Début de l'événement.
  dateDebut    DateTime        @map("date_debut")
  /// Fin de l'événement.
  dateFin      DateTime?       @map("date_fin")
  /// Lieu tel que saisi, en texte libre — non géocodé.
  lieu         String          @db.VarChar(200)
  /// Centre organisateur, quand l'événement s'y tient.
  centreId     String?         @map("centre_id") @db.VarChar(36)
  /// Nombre de places. Au-delà, les inscriptions basculent en liste d'attente.
  capaciteMax  Int?            @map("capacite_max")
  /// Participation gratuite.
  estGratuit   Boolean         @default(true) @map("est_gratuit")
  // Rappel SMS envoyé 24h avant (job planifié vérifie ce flag)
  rappelEnvoye Boolean         @default(false) @map("rappel_envoye")
  /// Date de création de la fiche.
  createdAt    DateTime        @default(now()) @map("created_at")
  /// Dernière modification. Watermark de réplication Data Hub.
  updatedAt    DateTime        @updatedAt @map("updated_at")

  centre       Centre?                @relation(fields: [centreId], references: [id])
  inscriptions InscriptionEvenement[]
  programmes   EvenementProgramme[]

  @@index([dateDebut, statut])
  @@index([updatedAt, id])
  @@map("evenements")
}

/// Inscription d'un jeune à un événement, unique par couple (jeune, événement). Le statut `present` matérialise la présence constatée, pas l'intention.
model InscriptionEvenement {
  /// Identifiant de l'inscription.
  id          String            @id @default(uuid()) @db.VarChar(36)
  /// Jeune inscrit — clé de jointure vers `utilisateurs`.
  cjsUid      String            @map("cjs_uid") @db.VarChar(36)
  /// Événement concerné — clé de jointure vers `evenements`.
  evenementId String            @map("evenement_id") @db.VarChar(36)
  /// `inscrit`, `liste_attente`, `annule`, ou `present` une fois la présence constatée.
  statut      StatutInscription @default(inscrit)
  /// Date de l'inscription.
  inscritA    DateTime          @default(now()) @map("inscrit_a")
  /// Dernière modification. Watermark de réplication Data Hub.
  updatedAt   DateTime          @updatedAt @map("updated_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid])
  evenement   Evenement   @relation(fields: [evenementId], references: [id])

  @@unique([cjsUid, evenementId])
  @@index([updatedAt, id])
  @@map("inscriptions_evenements")
}

// ─────────────────────────────────────────────
// M6 — RESSOURCES PÉDAGOGIQUES
// ─────────────────────────────────────────────

/// Ressource documentaire du catalogue — PDF, vidéo, lien, guide ou outil.
model Ressource {
  /// Identifiant de la ressource.
  id          String           @id @default(uuid()) @db.VarChar(36)
  drupalNid   Int?             @unique @map("drupal_nid")
  /// Intitulé de la ressource tel qu'affiché.
  titre       String           @db.VarChar(255)
  description String           @db.Text
  /// Support : `PDF`, `Video`, `Lien`, `Guide`, `Outil`.
  type        TypeRessource
  /// Thématique principale, saisie libre côté admin.
  theme       String           @db.VarChar(100)
  url         String           @db.VarChar(500)
  /// Ressource accessible sans authentification.
  estPublic   Boolean          @default(true) @map("est_public")
  /// Compteur cumulé de consultations. Incrémenté en direct, sans déduplication par visiteur.
  vues        Int              @default(0)
  /// GUIC-24 — filtres avancés. Nullable : enrichissement progressif côté admin.
  niveau      NiveauRessource? @map("niveau")
  /// Langue du contenu.
  langue      LangueRessource? @map("langue")
  /// Catégorie de classement complémentaire au thème.
  categorie   String?          @map("categorie") @db.VarChar(100)
  /// Date de publication de la ressource.
  createdAt   DateTime         @default(now()) @map("created_at")
  /// Dernière modification. Watermark de réplication Data Hub.
  updatedAt   DateTime         @updatedAt @map("updated_at")

  favoris    RessourceFavorite[]
  programmes RessourceProgramme[]

  @@index([type, theme])
  @@index([niveau])
  @@index([langue])
  @@index([updatedAt, id])
  @@map("ressources")
}

model RessourceFavorite {
  cjsUid      String   @map("cjs_uid") @db.VarChar(36)
  ressourceId String   @map("ressource_id") @db.VarChar(36)
  createdAt   DateTime @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid])
  ressource   Ressource   @relation(fields: [ressourceId], references: [id])

  @@id([cjsUid, ressourceId])
  @@map("ressources_favorites")
}

// ─────────────────────────────────────────────
// M10 — INTEROPÉRABILITÉ : LOGS
// Les webhooks entrants utilisent Redis pour l'idempotence (event_id, TTL 7j)
// InteropLog persiste pour audit et debugging uniquement
// ─────────────────────────────────────────────

model InteropLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  source      String   @db.VarChar(50)
  eventType   String   @map("event_type") @db.VarChar(100)
  eventId     String   @map("event_id") @db.VarChar(100)
  payload     Json
  statut      String   @db.VarChar(20)
  erreur      String?  @db.Text
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([source, eventType])
  @@index([eventId])
  @@map("interop_logs")
}

// ─────────────────────────────────────────────
// M11 — WHATSAPP AÏSSATOU
// ─────────────────────────────────────────────

model ConversationWhatsApp {
  id        String   @id @default(uuid()) @db.VarChar(36)
  telephone String   @db.VarChar(20)
  cjsUid    String?  @map("cjs_uid") @db.VarChar(36)
  // Horodatage de la liaison téléphone ↔ compte via lien magique (GUIC-140).
  // NULL tant que le numéro n'est pas lié à un cjs_uid.
  linkedAt  DateTime? @map("linked_at")
  // Contexte de conversation sérialisé (historique Groq)
  contexte  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // GUIC-140 — droit à l'oubli (CDP) : la suppression d'un compte purge sa
  // conversation WhatsApp (téléphone + messages = PII) au lieu de la détacher.
  // Les conversations non liées (cjsUid NULL) ne sont pas concernées.
  utilisateur Utilisateur?      @relation(fields: [cjsUid], references: [cjsUid], onDelete: Cascade)
  messages    MessageWhatsApp[]

  @@unique([telephone])
  @@map("conversations_whatsapp")
}

model MessageWhatsApp {
  id             String   @id @default(uuid()) @db.VarChar(36)
  conversationId String   @map("conversation_id") @db.VarChar(36)
  wamid          String   @unique @db.VarChar(100)
  sens           String   @db.VarChar(10)
  contenu        String   @db.Text
  type           String   @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  // Cascade : purger une conversation (droit à l'oubli) purge ses messages.
  conversation ConversationWhatsApp @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages_whatsapp")
}

// ─────────────────────────────────────────────
// M11 — NOTIFICATIONS UTILISATEUR (GUIC-247)
// Notifications persistées, affichées dans /jeune/notifications.
// Distinct du dispatcher multi-canal (WhatsApp/SMS) — ici c'est le centre
// de notifications applicatif (in-app).
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.VarChar(36)
  cjsUid    String           @map("cjs_uid") @db.VarChar(36)
  type      TypeNotification
  titre     String           @db.VarChar(255)
  contenu   String           @db.Text
  iconName  String?          @map("icon_name") @db.VarChar(32)
  lien      String?          @db.VarChar(500)
  metaPill  String?          @map("meta_pill") @db.VarChar(64)
  luA       DateTime?        @map("lu_a")
  createdAt DateTime         @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid], onDelete: Cascade)

  @@index([cjsUid, createdAt(sort: Desc)])
  @@index([cjsUid, luA])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// GUIC-547 — CENTRE DE NOTIFICATIONS MULTICANAL
// Config admin (événement × rôle → canaux) + préférences/consentement par canal.
// ─────────────────────────────────────────────

enum CanalNotification {
  in_app
  whatsapp
  sms
  email

  @@map("canal_notification")
}

// Mode de déclenchement d'une notification (GUIC-547 évolution).
enum ModeNotification {
  auto // envoi immédiat dès l'événement (défaut)
  validation // mis en file d'attente, validé par un humain avant envoi
  differe // envoyé automatiquement delaiMinutes après l'événement

  @@map("mode_notification")
}

// Matrice admin (GUIC-550) : pour un (événement × rôle), quels canaux sont activés.
// Fallback si absent = `defaultChannels` du catalogue (src/lib/notifications/catalog.ts).
model NotificationEventConfig {
  id           String           @id @default(uuid()) @db.VarChar(36)
  eventKey     String           @map("event_key") @db.VarChar(80)
  role         String           @db.VarChar(40)
  canaux       Json // liste de CanalNotification, ex. ["in_app","whatsapp"]
  actif        Boolean          @default(true)
  mode         ModeNotification @default(auto)
  delaiMinutes Int?             @map("delai_minutes") // requis si mode=differe
  updatedBy    String?          @map("updated_by") @db.VarChar(36)
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([eventKey, role])
  @@map("notification_event_config")
}

// Statut d'un envoi dans l'outbox/historique.
enum StatutEnvoiNotification {
  en_attente_validation // mode validation — attend un humain
  planifiee // mode différé — dueAt fixe l'échéance
  envoyee
  rejetee // refusé par le valideur
  echec_retry // échec transitoire, en file DLQ
  abandonnee // échec permanent

  @@map("statut_envoi_notification")
}

// Outbox + historique des envois (GUIC-547 évolution) : une ligne par
// (occurrence × destinataire × canal). Rétention permanente (décision PO) ;
// droit à l'effacement couvert par la cascade cjsUid.
model NotificationEnvoi {
  id         String                  @id @default(uuid()) @db.VarChar(36)
  eventKey   String                  @map("event_key") @db.VarChar(80)
  // Clé d'occurrence `${eventKey}:${entityId}` — groupe les lignes d'une même émission.
  eventId    String                  @map("event_id") @db.VarChar(191)
  cjsUid     String                  @map("cjs_uid") @db.VarChar(36)
  role       String                  @db.VarChar(40)
  canal      CanalNotification
  type       TypeNotification
  titre      String                  @db.VarChar(255)
  contenu    String                  @db.Text
  lien       String?                 @db.VarChar(500)
  iconName   String?                 @map("icon_name") @db.VarChar(32)
  statut     StatutEnvoiNotification
  erreur     String?                 @db.VarChar(500)
  valideePar String?                 @map("validee_par") @db.VarChar(36)
  dueAt      DateTime?               @map("due_at")
  envoyeeA   DateTime?               @map("envoyee_a")
  createdAt  DateTime                @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid], onDelete: Cascade)

  @@index([statut, createdAt(sort: Desc)])
  @@index([statut, dueAt])
  @@index([eventId])
  @@index([cjsUid])
  @@map("notification_envois")
}

// Surcharges des templates d'emails (GUIC-553 évolution) : les DÉFAUTS vivent dans
// le code (src/lib/email/templates.ts) ; la DB ne stocke que les versions éditées.
// ownerUid "" = version système (admin) ; sinon cjsUid du recruteur propriétaire.
// Résolution : version du recruteur ?? version système ?? défaut du code.
model EmailTemplate {
  id        String   @id @default(uuid()) @db.VarChar(36)
  cle       String   @db.VarChar(80)
  ownerUid  String   @default("") @map("owner_uid") @db.VarChar(36)
  sujet     String   @db.VarChar(255)
  corps     String   @db.Text
  updatedBy String?  @map("updated_by") @db.VarChar(36)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cle, ownerUid])
  @@map("email_templates")
}

// Connexion Google (Meet / Calendar) d'un recruteur — génération auto des liens
// Meet à la planification d'entretiens Visio. Tokens serveur uniquement (jamais
// exposés client) ; suppression = déconnexion.
model RecruteurGoogleAuth {
  cjsUid       String   @id @map("cjs_uid") @db.VarChar(36)
  googleEmail  String   @map("google_email") @db.VarChar(255)
  accessToken  String   @map("access_token") @db.Text
  refreshToken String?  @map("refresh_token") @db.Text
  expiresAt    DateTime @map("expires_at")
  scopes       String   @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("recruteur_google_auth")
}

// Préférences & consentement par canal, par utilisateur (GUIC-554 + CDP).
// `consentGiven` = opt-in légal (obligatoire hors in_app) ; `enabled` = confort.
model NotificationPreference {
  id            String            @id @default(uuid()) @db.VarChar(36)
  cjsUid        String            @map("cjs_uid") @db.VarChar(36)
  canal         CanalNotification
  consentGiven  Boolean           @default(false) @map("consent_given")
  consentAt     DateTime?         @map("consent_at")
  consentSource String?           @map("consent_source") @db.VarChar(40)
  enabled       Boolean           @default(true)
  categoriesOff Json?             @map("categories_off") // event keys désactivés par l'utilisateur
  updatedAt     DateTime          @updatedAt @map("updated_at")

  utilisateur Utilisateur @relation(fields: [cjsUid], references: [cjsUid], onDelete: Cascade)

  @@unique([cjsUid, canal])
  @@map("notification_preferences")
}

// ─────────────────────────────────────────────
