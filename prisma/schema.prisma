// ─────────────────────────────────────────────
// ONBOARDING DRAFT
// ─────────────────────────────────────────────
// Brouillon onboarding persisté server-side (remplace sessionStorage).
// Permet la reprise multi-device et la résilience (cybercafé, switch desktop/mobile).
// Une seule ligne par utilisateur (clé = cjs_uid). Supprimé à la finalisation.
model OnboardingDraft {
  cjsUid        String    @id @map("cjs_uid") @db.VarChar(36)
  // Tableau d'IDs d'objectifs (ex: ["emploi","projet"]) — JSON
  objectifs     Json?
  telephone     String?   @db.VarChar(20)
  prenom        String?   @db.VarChar(100)
  nom           String?   @db.VarChar(100)
  dateNaissance DateTime? @map("date_naissance")
  // Stocké en VARCHAR car peut contenir une valeur non encore alignée sur l'enum Region (saisie partielle).
  genre         String?   @db.VarChar(20)
  region        String?   @db.VarChar(50)
  commune       String?   @db.VarChar(100)
  // GUIC-660 — stockés en VARCHAR (comme genre/region) pour la reprise multi-device
  // avant persistance finale (enum) au step 3 de l'onboarding.
  situationHandicap String? @map("situation_handicap") @db.VarChar(20)
  zoneHabitation    String? @map("zone_habitation")    @db.VarChar(10)
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("onboarding_drafts")
}

// ─────────────────────────────────────────────
// M3 v2 — Tables de référence (GUIC-182 / 178a/4)
// Voir .agent_context/specs/M3-schema-polymorphique.md §3
// Les jonctions OpportuniteSkill / OpportuniteTag arrivent en 178b
// (FK vers la nouvelle table Opportunite polymorphique).
// ─────────────────────────────────────────────

/// Programmes sectoriels CJS (4 — Yaakaar, YEAH, YJC, EduPop).
/// BRM = outil interne, exclu (décision Lead 2026-05-29).
model Programme {
  /// Identifiant du programme.
  id            String   @id @default(uuid()) @db.VarChar(36)
  /// Identifiant lisible utilisé dans l'URL publique.
  slug          String   @unique @db.VarChar(40)
  /// Nom du programme sectoriel — désigne un dispositif, jamais une personne.
  nom           String   @db.VarChar(80)
  description   String   @db.VarChar(255)
  gradientToken String   @map("gradient_token") @db.VarChar(80)
  /// Programme en cours. Un programme inactif reste exporté pour l'historique.
  actif         Boolean  @default(true)
  /// Date de création du programme.
  createdAt     DateTime @default(now()) @map("created_at")
  /// Dernière modification. Watermark de réplication Data Hub.
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Rattachements M:N (GUIC-684) — un contenu peut relever de plusieurs programmes.
  // La colonne 1:N historique `opportunites.programme_id` a été supprimée.
  opportuniteRattachements  OpportuniteProgramme[]
  ressourceRattachements    RessourceProgramme[]
  evenementRattachements    EvenementProgramme[]
  centreRattachements       CentreProgramme[]
  organisationRattachements OrganisationProgramme[]

  @@index([updatedAt, id])
  @@map("programmes")
}

// ─────────────────────────────────────────────
// GUIC-684 — Rattachement aux programmes (M:N)
//
// Prisma n'a pas de relation polymorphique : une table de jonction PAR entité,
// toutes de forme identique (patron `OpportuniteTag`). Le coût de la duplication
// est absorbé par `src/lib/programmes/rattachement.ts`, qui porte la logique.
//
// `principal` = le programme affiché quand l'UI n'a la place que d'un badge, et
// servi dans le scalaire `programme_slug` du Data Hub (contrat externe préservé).
// Invariants garantis côté applicatif (cf. spec §2) :
//  - au plus UN `principal = true` par entité ;
//  - le premier programme rattaché le devient automatiquement ;
//  - au moins un programme à la création (décision PO 2026-07-28).
// ─────────────────────────────────────────────

/// Rattachement d'une opportunité à un programme (GUIC-684 — M:N générique).
model OpportuniteProgramme {
  /// Offre rattachée — clé de jointure vers `opportunites`.
  opportuniteId String  @map("opportunite_id") @db.VarChar(36)
  /// Programme de rattachement — clé de jointure vers `programmes`.
  programmeId   String  @map("programme_id") @db.VarChar(36)
  /// Programme affiché en priorité quand l'UI n'a la place que d'un badge. Au plus un `true` par offre.
  principal     Boolean @default(false)

  opportunite Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)
  programme   Programme   @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@id([opportuniteId, programmeId])
  @@index([programmeId])
  @@map("opportunites_programmes")
}

/// Rattachement d'une ressource à un programme (GUIC-684 — M:N générique).
model RessourceProgramme {
  /// Ressource rattachée — clé de jointure vers `ressources`.
  ressourceId String  @map("ressource_id") @db.VarChar(36)
  /// Programme de rattachement — clé de jointure vers `programmes`.
  programmeId String  @map("programme_id") @db.VarChar(36)
  /// Programme affiché en priorité quand l'UI n'a la place que d'un badge. Au plus un `true` par ressource.
  principal   Boolean @default(false)

  ressource Ressource @relation(fields: [ressourceId], references: [id], onDelete: Cascade)
  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@id([ressourceId, programmeId])
  @@index([programmeId])
  @@map("ressources_programmes")
}

/// Rattachement d'un événement à un programme (GUIC-684 — M:N générique).
model EvenementProgramme {
  /// Événement rattaché — clé de jointure vers `evenements`.
  evenementId String  @map("evenement_id") @db.VarChar(36)
  /// Programme de rattachement — clé de jointure vers `programmes`.
  programmeId String  @map("programme_id") @db.VarChar(36)
  /// Programme affiché en priorité quand l'UI n'a la place que d'un badge. Au plus un `true` par événement.
  principal   Boolean @default(false)

  evenement Evenement @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@id([evenementId, programmeId])
  @@index([programmeId])
  @@map("evenements_programmes")
}

/// Centres où un programme est déployé (GUIC-684 — extension acteurs).
/// FACULTATIF, contrairement aux contenus : un centre est une infrastructure qui
/// existe indépendamment des programmes qui s'y déploient.
model CentreProgramme {
  /// Centre rattaché — clé de jointure vers `centres`.
  centreId    String  @map("centre_id") @db.VarChar(36)
  /// Programme de rattachement — clé de jointure vers `programmes`.
  programmeId String  @map("programme_id") @db.VarChar(36)
  /// Programme affiché en priorité quand l'UI n'a la place que d'un badge. Au plus un `true` par centre.
  principal   Boolean @default(false)

  centre    Centre    @relation(fields: [centreId], references: [id], onDelete: Cascade)
  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@id([centreId, programmeId])
  @@index([programmeId])
  @@map("centres_programmes")
}

/// Organisations partenaires d'un programme (GUIC-684 — extension acteurs).
/// FACULTATIF : un partenaire peut publier des offres sans relever d'un programme.
model OrganisationProgramme {
  /// Organisation rattachée — clé de jointure vers `organisations`.
  organisationId String  @map("organisation_id") @db.VarChar(36)
  /// Programme de rattachement — clé de jointure vers `programmes`.
  programmeId    String  @map("programme_id") @db.VarChar(36)
  /// Programme affiché en priorité quand l'UI n'a la place que d'un badge. Au plus un `true` par organisation.
  principal      Boolean @default(false)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  programme    Programme    @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@id([organisationId, programmeId])
  @@index([programmeId])
  @@map("organisations_programmes")
}

/// Types d'opportunité — remplace l'enum TypeOpportunite (qui survit pendant migration).
/// Permet d'ajouter dynamiquement actionLabel / workflow sans migration Prisma.
model OpportuniteType {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  slug               String   @unique @db.VarChar(40)
  libelle            String   @db.VarChar(80)
  actionLabel        String   @map("action_label") @db.VarChar(40)
  requiresFileUpload Boolean  @default(false) @map("requires_file_upload")
  fileLabel          String?  @map("file_label") @db.VarChar(80)
  decisionAuthority  String?  @map("decision_authority") @db.VarChar(100)
  actif              Boolean  @default(true)
  ordre              Int      @default(0)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  opportunites Opportunite[]
  sourcesVeille SourceVeille[]

  @@map("opportunite_types")
}

/// Compétences requises sur les opportunités (M:N).
/// Jonction OpportuniteSkill créée en 178b avec la table Opportunite mère.
model Skill {
  id        String   @id @default(uuid()) @db.VarChar(36)
  slug      String   @unique @db.VarChar(80)
  libelle   String   @db.VarChar(120)
  categorie String?  @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at")

  opportunites OpportuniteSkill[]

  @@map("skills")
}

/// Tags transversaux (urgent, télétravail, diaspora…).
/// Jonction OpportuniteTag créée en 178b avec la table Opportunite mère.
model Tag {
  id        String   @id @default(uuid()) @db.VarChar(36)
  slug      String   @unique @db.VarChar(80)
  libelle   String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  opportunites OpportuniteTag[]

  @@map("tags")
}

// ─────────────────────────────────────────────
// M3 v2 — Sous-types CTI (GUIC-183 / 178b/4)
// Cf. spec §3.4 et §3.5 — relations 1:1 vers Opportunite avec cascade.
