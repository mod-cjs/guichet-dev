{
  "name": "guichet-jeunesse",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && mkdir -p .next/standalone/.next && { cp -R .next/static .next/standalone/.next/static 2>/dev/null || true; } && { cp -R public .next/standalone/public 2>/dev/null || true; }",
    "vercel-build": "prisma migrate deploy && next build && mkdir -p .next/standalone/.next && { cp -R .next/static .next/standalone/.next/static 2>/dev/null || true; } && { cp -R public .next/standalone/public 2>/dev/null || true; }",
    "start": "next start",
    "lint": "eslint src",
    "test": "sh scripts/test/run-all.sh",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "VISUAL_ACTIVE=1 playwright test -c playwright.visual.config.ts",
    "test:visual:update": "VISUAL_ACTIVE=1 playwright test -c playwright.visual.config.ts --update-snapshots",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "yaye:eval": "tsx scripts/yaye-eval-local.ts",
    "yaye:reproject": "tsx scripts/yaye-graph-reproject.ts",
    "yaye:latency": "tsx scripts/yaye-graph-latency.ts",
    "yaye:warm": "tsx scripts/yaye-warm-search.ts",
    "db:load:enriched": "bash scripts/load-enriched-db.sh",
    "db:diversify:enriched": "docker exec -i guichet_mariadb mariadb -uroot -proot yaye_poc_enriched < scripts/sql/diversify-enriched.sql",
    "db:programmes:enriched": "docker exec -i guichet_mariadb mariadb -uroot -proot -t yaye_poc_enriched < scripts/sql/attach-programmes-enriched.sql",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:deploy": "prisma migrate deploy",
    "deploy": "npm run build && prisma migrate deploy",
    "postinstall": "prisma generate",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "validate": "npm run lint && npx tsc --noEmit && npm run test -- --no-coverage",
    "build:prod": "prisma generate && next build",
    "start:prod": "node .next/standalone/server.js",
    "migrate:all": "tsx scripts/migrate-all.ts",
    "migrate:all:dry-run": "tsx scripts/migrate-all.ts --dry-run",
    "migrate:drupal": "tsx scripts/migrate-drupal.ts",
    "migrate:drupal:dry-run": "tsx scripts/migrate-drupal.ts --dry-run",
    "migrate:drupal:profils": "tsx scripts/migrate-drupal.ts --phase=profils",
    "migrate:drupal:contenus": "tsx scripts/migrate-drupal.ts --phase=opportunites && tsx scripts/migrate-drupal.ts --phase=evenements && tsx scripts/migrate-drupal.ts --phase=ressources",
    "migrate:drupal:users:dry-run": "tsx scripts/migrate-drupal-users.ts",
    "migrate:drupal:users:apply": "tsx scripts/migrate-drupal-users.ts --apply",
    "migrate:phones": "tsx scripts/backfill-sso-phones.ts",
    "migrate:sso:create": "tsx scripts/create-sso-accounts.ts",
    "migrate:sso:create:dry-run": "tsx scripts/create-sso-accounts.ts --dry-run",
    "migrate:sso:sync": "tsx scripts/sync-utilisateurs-sso.ts",
    "migrate:sso:sync:dry-run": "tsx scripts/sync-utilisateurs-sso.ts --dry-run",
    "migration:rehearsal:up": "docker compose -f docker-compose.migration.yml up -d",
    "migration:rehearsal:down": "docker compose -f docker-compose.migration.yml down -v",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "storybook:public": "storybook build --output-dir public/storybook --quiet",
    "db:comments": "tsx scripts/db/sync-comments.ts",
    "db:repair": "tsx scripts/sql/apply-repair.ts",
    "datahub:openapi": "tsx scripts/datahub/generate-openapi.ts",
    "datahub:tap": "tsx scripts/datahub/generate-tap-manifest.ts",
    "datahub:dbt": "tsx scripts/datahub/generate-dbt-sources.ts",
    "datahub:generate": "npm run datahub:openapi && npm run datahub:tap && npm run datahub:dbt",
    "datahub:preflight": "tsx scripts/datahub/preflight.ts",
    "datahub:reconcile": "tsx scripts/datahub/reconcile.ts",
    "datahub:purge-absents": "tsx scripts/datahub/purge-absents.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@googlemaps/js-api-loader": "^1.16.6",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/adapter-planetscale": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tiptap/extension-character-count": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@vercel/blob": "^2.4.0",
    "autoprefixer": "^10.4.20",
    "css-select": "^5.2.2",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "mysql2": "^3.22.3",
    "neo4j-driver": "^6.1.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.25",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.4",
    "postcss": "^8.4.47",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.5",
    "tailwindcss": "^3.4.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/nextjs-vite": "^9.1.20",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^16.6.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "storybook": "^9.1.20",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.4.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  }
}
