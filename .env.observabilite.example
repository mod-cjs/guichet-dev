# Gabarit des variables attendues par docker-compose.observabilite.yml (GUIC-544/576).
# JAMAIS de vraie valeur ici — ce fichier est versionné. Copier vers un fichier réel local
# (.env.observabilite), ou directement sur le serveur (ex. /etc/guichet/observabilite.env,
# chmod 600), jamais commité (voir .gitignore : .env.observabilite).
#
# GUIC-700 (audit M14) — trouvé jamais déployé ni en préprod ni en prod au moment de
# l'audit : docker-compose.observabilite.yml ne référence en commentaire que
# /etc/guichet/prod.env, mais n'a AUCUNE dépendance technique réelle à ce nom — les deux
# variables obligatoires ci-dessous suffisent, quel que soit l'environnement.

# Obligatoire — Grafana refuse de démarrer sans (pas de défaut "admin", volontaire).
# Générer avec : openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=<mot-de-passe-fort>
GRAFANA_ADMIN_USER=admin

# Obligatoire — un canal d'alerte vide est pire qu'absent (on croit être couvert).
# Destinataires d'astreinte, séparés par des virgules, sans espace.
ALERTE_EMAILS=<email1@exemple.org,email2@exemple.org>

# Optionnels — relais WhatsApp (GUIC-575, hébergé HORS du serveur, Cloudflare Worker à
# créer séparément). Réellement optionnels (GUIC-576, select-contact-points.sh) : absents,
# le point de contact webhook est retiré du provisioning AVANT que Grafana ne démarre —
# seul le canal e-mail fonctionne, dégradé mais pas silencieux, et Grafana démarre quand
# même (une URL vide plantait tout l'amorçage avant ce correctif).
ALERTE_WEBHOOK_URL=
ALERTE_WEBHOOK_TOKEN=

# Obligatoires — SANS EUX le point de contact e-mail se provisionne sans erreur mais ne
# peut RIEN envoyer (« SMTP not configured »). Distinct de ALERTE_EMAILS (destinataires) :
# ici, le relais SORTANT que Grafana utilise pour émettre. Même compte que la SSO
# (../cjs_auth/.env, SMTP2GO) — à réutiliser, pas à recréer.
GF_SMTP_HOST=mail.smtp2go.com:2525
GF_SMTP_USER=<voir ../cjs_auth/.env : MAIL_USERNAME>
GF_SMTP_PASSWORD=<voir ../cjs_auth/.env : MAIL_PASSWORD>
GF_SMTP_FROM_ADDRESS=noreply@consortiumjeunessesenegal.org
GF_SMTP_FROM_NAME=Guichet Jeunesse — Astreinte
