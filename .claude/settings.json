{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/pre-commit-check.sh" },
          { "type": "command", "command": ".claude/hooks/guard-commit-format.sh" }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/guard-hex.sh" }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/guard-hex.sh" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": ".claude/hooks/save-agent-report.sh" }
        ]
      }
    ]
  },
  "mcpServers": {
    "jira": {
      "command": "npx",
      "args": ["-y", "@smithery/cli@latest", "run", "@aptbytes/mcp-server-jira", "--", "--config", "{}"],
      "env": {
        "JIRA_BASE_URL": "https://consortiumjeunesse.atlassian.net",
        "JIRA_EMAIL": "ryhow99@gmail.com",
        "JIRA_API_TOKEN": ""
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  }
}
