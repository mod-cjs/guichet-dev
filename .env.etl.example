# Gabarit des variables attendues par docker-compose.etl.yml (voir GUICHET_ETL_ENV_FILE).
# JAMAIS de vraie valeur ici — ce fichier est versionné. Copier vers un fichier réel
# (.env.etl en local, /etc/guichet/etl-<env>.env en serveur, chmod 600), jamais commité
# (voir .gitignore : .env.etl, .env.etl.*).
#
# GUIC-700 — trouvé manquant lors du premier déploiement réel : ce gabarit existe pour que
# la variable WAREHOUSE_DATABASE_URL (utilisée par reconcile.ts/purge-absents.ts, PAS par
# meltano/target-postgres) ne soit plus oubliée. Voir docs/datahub-briefing-etl.md §6.

# ── Guichet (côté tap) ──────────────────────────────────────────────────────────────────
# SÉPARATION, jamais d'adresse interne (etl/meltano.yml fixe déjà l'URL publique par
# défaut) : le Data Hub est une route machine-à-machine pensée pour être appelée de
# l'extérieur, comme BRM/Centres/Moodle/EduPop — jamais host.docker.internal, jamais un
# réseau Docker partagé avec l'app.
TAP_GUICHET_API_URL=https://<domaine-public-de-cet-environnement>
TAP_GUICHET_AUTH_TOKEN=<le secret — même valeur que meltano: dans DATAHUB_API_KEYS côté app>

# ── Entrepôt PostgreSQL (côté target-postgres / dbt) ────────────────────────────────────
TARGET_POSTGRES_HOST=<hôte ou nom de conteneur de l'entrepôt>
TARGET_POSTGRES_PORT=5432
TARGET_POSTGRES_USER=<utilisateur>
TARGET_POSTGRES_PASSWORD=<mot de passe>
TARGET_POSTGRES_DATABASE=<base>
TARGET_POSTGRES_SSLMODE=require

DBT_POSTGRES_HOST=<même valeur que TARGET_POSTGRES_HOST>
DBT_POSTGRES_PORT=5432
DBT_POSTGRES_USER=<même valeur que TARGET_POSTGRES_USER>
DBT_POSTGRES_PASSWORD=<même valeur que TARGET_POSTGRES_PASSWORD>
DBT_POSTGRES_DB=<même valeur que TARGET_POSTGRES_DATABASE>

# État Meltano externalisé — sans elle, le bookmark vit dans le SQLite d'un conteneur
# --rm et repart de zéro à chaque run, sans erreur visible (GUIC-696 R5).
MELTANO_DATABASE_URI=postgresql://<user>:<mdp>@<hôte>:5432/<base>

# Sondée par reconcile.ts/purge-absents.ts (scripts/datahub/psql-entrepot.ts), PAS par
# meltano lui-même — même serveur/base que ci-dessus, sous forme d'URI complète. Oubliée
# une première fois lors du déploiement réel : "WAREHOUSE_DATABASE_URL absente".
WAREHOUSE_DATABASE_URL=postgresql://<user>:<mdp>@<hôte>:5432/<base>
