{
  "contract_version": "2.0",
  "streams": [
    {
      "name": "utilisateurs",
      "path": "/api/v1/export/utilisateurs",
      "primary_keys": [
        "cjs_uid"
      ],
      "replication_key": "updated_at",
      "replication_method": "INCREMENTAL",
      "schema": {
        "type": "object",
        "properties": {
          "cjs_uid": {
            "type": [
              "string"
            ],
            "description": "Claim `sub` du token SSO — identifiant pivot du jeune dans tout l'écosystème CJS, et seule clé de jointure inter-plateformes.",
            "x-cjs-tier": "pseudonyme"
          },
          "region": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Dakar",
              "Thies",
              "Diourbel",
              "Fatick",
              "Kaolack",
              "Kaffrine",
              "Louga",
              "Saint_Louis",
              "Matam",
              "Tambacounda",
              "Kedougou",
              "Kolda",
              "Ziguinchor",
              "Sedhiou",
              null
            ],
            "description": "Région administrative de résidence, parmi les 14 du Sénégal.",
            "x-cjs-tier": "public"
          },
          "commune": {
            "type": [
              "string",
              "null"
            ],
            "description": "Commune de résidence, saisie libre à l'onboarding — non normalisée.",
            "x-cjs-tier": "public"
          },
          "genre": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "M",
              "F",
              null
            ],
            "description": "Genre déclaré : `M` ou `F`.",
            "x-cjs-tier": "public"
          },
          "tranche_age": {
            "type": [
              "string"
            ],
            "description": "Tranche d'âge à la date d'extraction : -18, 18-24, 25-29, 30-34, 35+, ou inconnu quand la date de naissance est absente ou aberrante. Dérivée d'une donnée identifiante qui, elle, n'est jamais exportée.",
            "x-cjs-tier": "public"
          },
          "statut": {
            "type": [
              "string"
            ],
            "enum": [
              "actif",
              "inactif",
              "anonymise"
            ],
            "description": "État du compte : `actif`, `inactif`, ou `anonymise` après exercice du droit à l'oubli.",
            "x-cjs-tier": "public"
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "description": "Rôle principal mis en cache depuis le SSO (source de vérité = SSO ; synchronisé au login).",
            "x-cjs-tier": "public"
          },
          "onboarding_complete": {
            "type": [
              "boolean"
            ],
            "description": "Le parcours d'onboarding a été mené à son terme. Distingue un compte créé d'un compte réellement activé.",
            "x-cjs-tier": "public"
          },
          "date_inscription": {
            "type": [
              "string"
            ],
            "format": "date-time",
            "description": "Date de création du compte — sert de date d'inscription dans les indicateurs.",
            "x-cjs-tier": "public"
          },
          "updated_at": {
            "type": [
              "string"
            ],
            "format": "date-time",
            "description": "Dernière modification du compte. Watermark de réplication Data Hub.",
            "x-cjs-tier": "public"
          },
          "deleted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Suppression logique. Non nulle, la ligne reste exportée avec cette date pour que l'entrepôt propage la suppression au lieu de conserver un fantôme.",
            "x-cjs-tier": "public"
          }
        }
      }
    },
    {
      "name": "profils_jeunes",
      "path": "/api/v1/export/profils_jeunes",
      "primary_keys": [
        "id"
      ],
      "replication_key": "updated_at",
      "replication_method": "INCREMENTAL",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "string"
            ],
            "description": "Identifiant technique du profil, distinct du `cjs_uid` du compte porteur.",
            "x-cjs-tier": "pseudonyme"
          },
          "cjs_uid": {
            "type": [
              "string"
            ],
            "description": "Compte porteur du profil — clé de jointure vers `utilisateurs`.",
            "x-cjs-tier": "pseudonyme"
          },
          "niveau_etude": {
            "type": [
              "string",
              "null"
            ],
            "description": "Niveau d'études le plus élevé atteint, déclaré par le jeune.",
            "x-cjs-tier": "public"
          },
          "situation_emploi": {
            "type": [
              "string",
              "null"
            ],
            "description": "Situation professionnelle déclarée au moment de la dernière mise à jour du profil.",
            "x-cjs-tier": "public"
          },
          "situation_handicap": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "aucun",
              "moteur",
              "visuel",
              "auditif",
              "autre",
              "non_precise",
              null
            ],
            "description": "Situation de handicap auto-déclarée : `aucun`, `moteur`, `visuel`, `auditif`, `autre`, `non_precise`. Facultative et hors score de complétion (GUIC-660).",
            "x-cjs-tier": "public"
          },
          "zone_habitation": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "rural",
              "urbain",
              null
            ],
            "description": "Zone d'habitation auto-déclarée : `rural` ou `urbain`. Facultative (GUIC-660).",
            "x-cjs-tier": "public"
          },
          "completion_score": {
            "type": [
              "integer"
            ],
            "description": "Score 0–100 calculé et mis à jour dans ProfilService.recalculerScore()",
            "x-cjs-tier": "public"
          },
          "centre_principal_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Centre de rattachement principal, suggéré à l'onboarding depuis la région SSO puis modifiable.",
            "x-cjs-tier": "pseudonyme"
          },
          "created_at": {
            "type": [
              "string"
            ],
            "format": "date-time",
            "description": "Date de création du profil.",
            "x-cjs-tier": "public"
          },
          "updated_at": {
            "type": [
              "string"
            ],
            "format": "date-time",
            "description": "Dernière modification du profil. Watermark de réplication Data Hub.",
            "x-cjs-tier": "public"
          }
        }
      }
    },
