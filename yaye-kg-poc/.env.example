# ── Neo4j — LOCAL d'abord (service du docker-compose projet) ───────────
# Travail en local sur le Neo4j du compose projet (guichet_neo4j).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=yaye_dev_password
NEO4J_DATABASE=neo4j

# ── Neo4j Aura (online) — décommenter pour pousser les données en prod ──
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=change-me
# NEO4J_DATABASE=neo4j

# ── Source SQL — MariaDB du projet (guichet_mariadb), base yaye_poc ────
# Le dump (MySQL 9.4) est chargé dans une base dédiée `yaye_poc` de la
# MariaDB du projet → ne touche pas à `guichet_jeunesse` (géré par Prisma).
# Noms de variables MARIADB_* lus par graph_loader.py.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3307
MARIADB_USER=guichet
MARIADB_PASSWORD=guichet_dev_password
MARIADB_DATABASE=yaye_poc
