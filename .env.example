# =============================================================
# GUICHET JEUNESSE CJS — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# Ne JAMAIS commiter .env.local dans Git
# =============================================================

# ─────────────────────────────────────────────────────────────
# BASE DE DONNÉES
# ─────────────────────────────────────────────────────────────

# Développement LOCAL (npm run dev sans Docker) — VOIE CANONIQUE : dataset POC
# enrichi `yaye_poc_enriched` (≈22 000 users, 4 340 offres) pour éprouver Yaye à
# volumétrie réelle, ALIGNÉ avec le graphe Neo4j `enriched`. Port hôte 3307.
# → Charger la base : `npm run db:load:enriched` (dump hors Git — voir docs/tester-en-local.md §6).
DATABASE_URL="mysql://guichet:guichet_dev_password@127.0.0.1:3307/yaye_poc_enriched"

# Variante « parité prod stricte » (schéma Prisma + seed, sans volumétrie) :
# DATABASE_URL="mysql://guichet:guichet_dev_password@127.0.0.1:3307/guichet_jeunesse"

# Développement via Docker Compose (docker-compose up) — surchargé automatiquement
# par docker-compose.yml (service `mariadb`). Ne pas utiliser localhost ici.
# DATABASE_URL="mysql://guichet:guichet_dev_password@mariadb:3306/yaye_poc_enriched"

# ─────────────────────────────────────────────────────────────
# MIGRATION DRUPAL (scripts ETL — jamais en prod Vercel)
# Connexion read-only sur la base Drupal de production
# Utilisé uniquement par : npm run migrate:drupal / migrate:phones
# ─────────────────────────────────────────────────────────────
# DRUPAL_DB_URL="mysql://drupal_user:password@drupal-host:3306/drupal_db"

# ─────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────

# Développement LOCAL
REDIS_URL="redis://localhost:6379"

# Développement via Docker Compose
# REDIS_URL="redis://redis:6379"

# PRODUCTION (GUIC-566) — Redis MUTUALISÉ entre les plateformes CJS (`redis_cjs`, 1 Go).
# Chaque plateforme a un utilisateur ACL qui ne lui donne accès QU'À SON PRÉFIXE DE CLÉ :
# une commande hors préfixe est rejetée par le serveur (`NOPERM`), et le rate-limiting
# comme l'idempotence des webhooks sauteraient en silence.
# L'utilisateur ACL et son mot de passe voyagent dans l'URL :
# REDIS_URL="redis://guichet:<motdepasse>@127.0.0.1:6379"
#
# Préfixe appliqué automatiquement à TOUTES nos clés (option `keyPrefix` d'ioredis, y compris
# dans un `multi()`). Doit correspondre au périmètre accordé côté serveur (`~guichet:*`).
# Défaut : "guichet:" — à surcharger seulement si le lead attribue un autre préfixe.
# REDIS_KEY_PREFIX="guichet:"

# ─────────────────────────────────────────────────────────────
# SSO CJS (OAuth 2.0 / OIDC)
# Demander les valeurs au Lead développeur
# ─────────────────────────────────────────────────────────────
SSO_BASE_URL="https://sso.cjs.sn"
# Identifiant numérique du client OAuth (ex: 7 pour Vercel, voir interface admin SSO)
SSO_CLIENT_ID=""
SSO_CLIENT_SECRET=""

# Clés HMAC server-to-server (vérification de token sans flux OAuth)
# Demander au Lead SSO — uniquement pour les appels machine-to-machine
SSO_API_KEY=""
SSO_API_SECRET=""

# Clé de signature des sessions JWT — générer avec : openssl rand -base64 32
# SESSION_SECRET est prioritaire. NEXTAUTH_SECRET est conservé comme fallback.
SESSION_SECRET=""
NEXTAUTH_SECRET=""
# NEXTAUTH_URL = URL publique du Guichet — sert aussi à construire la redirect_uri OAuth
# Doit correspondre exactement à la redirect_uri enregistrée dans l'admin SSO + "/auth/callback"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# CENTRES — Lot 7 Wave 6 (carte CJS + scanner staff)
# ─────────────────────────────────────────────────────────────
# Secret signature JWT QR carte CJS (HS256, TTL 15 min, ADR-002)
# openssl rand -hex 32
JWT_CJS_CARD_SECRET=""
# Whitelist emails conseillers staff autorisés au scanner (MVP, CSV)
# ex: "agent1@cjs.sn,agent2@cjs.sn"
CONSEILLER_STAFF_EMAILS=""
# Secret signature cookie session staff (HS256, TTL 12h)
# openssl rand -base64 32
STAFF_SESSION_SECRET=""

# ─────────────────────────────────────────────────────────────
# WHATSAPP — Meta Cloud API v19 (agent Aïssatou)
# ─────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# ─────────────────────────────────────────────────────────────
# IA — Fournisseur LLM de Yaye (GUIC-537)
# ─────────────────────────────────────────────────────────────
# Fournisseur : "vertex" (défaut, prod) ou "lmstudio" (dev local, aucune conf GCP).
# LLM_PROVIDER="vertex"

# --- Dev local : LMStudio (serveur OpenAI-compatible) ---
# Mettre LLM_PROVIDER="lmstudio" ci-dessus, lancer LMStudio (Local Server) + charger un modèle.
# En mode local, l'allowlist Vertex et la config admin sont ignorées (le modèle vient d'ici).
# LMSTUDIO_BASE_URL="http://localhost:1234/v1"   # défaut
# LMSTUDIO_MODEL="<id du modèle chargé dans LMStudio>"
# LMSTUDIO_API_KEY="lm-studio"                    # clé factice, non vérifiée

# --- Prod : Vertex AI (GCP), endpoint OpenAI-compatible, auth service account ---
GOOGLE_CLOUD_PROJECT=""                       # ID du projet GCP (requis si LLM_PROVIDER=vertex)
GOOGLE_CLOUD_LOCATION="us-central1"           # région Vertex (défaut us-central1)
GOOGLE_APPLICATION_CREDENTIALS=""             # chemin du JSON service account (ADC)
# Endpoint dédié pour les modèles self-deployed (Gemma). Requis SEULEMENT si tu
# sélectionnes un modèle « self-deployed » dans l'admin. Ex. :
# VERTEX_DEDICATED_ENDPOINT_URL="https://<ENDPOINT_ID>.<LOCATION>-<PROJECT_NUM>.prediction.vertexai.goog/v1beta1/..."

# Robustesse client (optionnel) :
# YAYE_LLM_TIMEOUT_MS="20000"     # abandon d'un appel pendu
# YAYE_LLM_MAX_RETRIES="2"        # retries 429/5xx/réseau

# Modèle par usage : piloté depuis l'admin (/admin/yaye/modele), persisté en base.
# Les variables ci-dessous ne sont qu'un REPLI si la table llm_config est vide.
# Défaut si tout est absent : google/gemini-2.5-flash.
# YAYE_MODEL="google/gemini-2.5-flash"          # slot agent (Yaye + mémoire)
# YAYE_JUDGE_MODEL="google/gemini-2.5-flash"    # slot juge (éval)
# ADEQUATION_MODEL="google/gemini-2.5-flash"    # slot score d'adéquation

# Tuning du modèle Yaye — toutes optionnelles (valeurs par défaut dans src/lib/ia/agent.ts).
# YAYE_TEMPERATURE="0.4"          # rounds de décision (choix d'outil) : bas = fiable
# YAYE_TEMPERATURE_FINAL="0.6"    # synthèse finale en langage naturel : plus haut = ton chaleureux/varié
# YAYE_MAX_TOKENS="768"           # réponse concise (WhatsApp plafonne à 4096 caractères)
# YAYE_TOP_P="0.9"
# YAYE_FREQUENCY_PENALTY="0.4"    # pénalise la répétition de tokens (ignoré par Gemini)
# YAYE_PRESENCE_PENALTY="0.3"     # varie les tournures/thèmes (ignoré par Gemini)
# YAYE_MAX_TOOL_ROUNDS="4"        # garde-fou boucle d'outils avant escalade
# YAYE_MAX_TOOL_RESULT_CHARS="6000"

# ─────────────────────────────────────────────────────────────
# IA — Knowledge Graph Neo4j (agent Yaye, Lot 1 / GUIC-259)
# Read-model dérivé de Prisma. Si NEO4J_URI/PASSWORD vides → fallback Prisma (R1).
# VOIE CANONIQUE locale : base `enriched`, projetée depuis yaye_poc_enriched via
# `npm run yaye:reproject`. Garder NEO4J_DATABASE aligné sur la cible de reprojection.
# (Nom de base Neo4j : pas d'underscore — contrainte Neo4j 5.)
# ─────────────────────────────────────────────────────────────
NEO4J_URI="bolt://localhost:7687"     # ou neo4j+s://<id>.databases.neo4j.io (Aura)
NEO4J_USER="neo4j"
NEO4J_PASSWORD="yaye_dev_password"
NEO4J_DATABASE="enriched"

# ─────────────────────────────────────────────────────────────
# STOCKAGE OBJET (GUIC-565) — CV, photos, diplômes, justificatifs
#
# Ces fichiers sont des DONNÉES PERSONNELLES : la référence stockée en base n'est pas
# une URL publique, et c'est l'application qui sert le contenu après vérification de
# l'autorisation (CDP).
#
# PRODUCTION OVH → MinIO du serveur. MinIO est un CONTENEUR : on l'adresse par son NOM sur le
#   réseau Docker partagé — surtout PAS 127.0.0.1 (qui désignerait notre propre conteneur), ni
#   https://store.consortiumjeunessesenegal.org (c'est la CONSOLE web, pas l'API S3 : elle sert
#   du HTML et le SDK échoue avec une erreur opaque).
#   Le pilote bascule automatiquement sur S3 dès que S3_ENDPOINT est renseigné.
# S3_ENDPOINT="http://<nom-du-conteneur-minio>:9000"
# S3_BUCKET="guichet"                  # quota 20 Gio
# S3_REGION="us-east-1"                # défaut ; MinIO n'en tient pas compte
#
#   Les DEUX nommages des clés sont acceptés (l'infra fournit la convention MinIO ; le SDK AWS
#   emploie la sienne). La variante AWS est prioritaire si les deux sont présentes.
# S3_ACCESS_KEY_ID=""                  # ou S3_ACCESS_KEY     — utilisateur dédié `guichet-app`
# S3_SECRET_ACCESS_KEY=""              # ou S3_SECRET_KEY
#
# MIROIR DE DEV (Vercel) → Vercel Blob. Le miroir ne peut PAS joindre le MinIO du serveur
# (celui-ci écoute sur la boucle locale d'OVH) : il garde donc Vercel Blob.
# BLOB_READ_WRITE_TOKEN=""
#
# Forçage explicite du pilote si besoin : "s3" ou "vercel".
# STORAGE_DRIVER="s3"
#
# NB : les fichiers déjà déposés sur Vercel Blob restent lisibles après la bascule —
# la lecture est résolue sur la FORME de la référence (https:// → Vercel, s3:// → MinIO),
# jamais sur le pilote actif.
#
# ⚠️ C-ST1 (challenge PR #251) — Fichiers Vercel HÉRITÉS depuis OVH :
#   - fichiers PUBLICS (photos, CV de profil) : lisibles sans token ;
#   - fichiers PRIVÉS (justificatifs, CV de candidature déposés en access:'private') :
#     nécessitent BLOB_READ_WRITE_TOKEN pour être relus → 401 sans lui.
#   Donc PENDANT LA TRANSITION, poser BLOB_READ_WRITE_TOKEN AUSSI sur OVH (en plus de
#   S3_*), sinon les justificatifs/CV antérieurs à la bascule deviennent illisibles.
#   Alternative durable : migrer ces fichiers de Vercel vers MinIO (ticket de suite).
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
