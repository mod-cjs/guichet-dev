# =============================================================
# GUICHET JEUNESSE CJS — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# Ne JAMAIS commiter .env.local dans Git
# =============================================================

# ─────────────────────────────────────────────────────────────
# BASE DE DONNÉES
# ─────────────────────────────────────────────────────────────

# Développement LOCAL (npm run dev sans Docker)
DATABASE_URL="mysql://guichet:guichet_dev_password@localhost:3306/guichet_jeunesse"

# Développement via Docker Compose (docker-compose up)
# Le service s'appelle "mariadb" dans le réseau Docker — ne pas utiliser localhost
# DATABASE_URL="mysql://guichet:guichet_dev_password@mariadb:3306/guichet_jeunesse"

# ─────────────────────────────────────────────────────────────
# MIGRATION DRUPAL (scripts ETL — jamais en prod Vercel)
# Connexion read-only sur la base Drupal de production
# Utilisé uniquement par : npm run migrate:drupal / migrate:phones
# ─────────────────────────────────────────────────────────────
# DRUPAL_DB_URL="mysql://drupal_user:password@drupal-host:3306/drupal_db"

# ─────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────

# Développement LOCAL
REDIS_URL="redis://localhost:6379"

# Développement via Docker Compose
# REDIS_URL="redis://redis:6379"

# ─────────────────────────────────────────────────────────────
# SSO CJS (OAuth 2.0 / OIDC)
# Demander les valeurs au Lead développeur
# ─────────────────────────────────────────────────────────────
SSO_BASE_URL="https://sso.cjs.sn"
# Identifiant numérique du client OAuth (ex: 7 pour Vercel, voir interface admin SSO)
SSO_CLIENT_ID=""
SSO_CLIENT_SECRET=""

# Clés HMAC server-to-server (vérification de token sans flux OAuth)
# Demander au Lead SSO — uniquement pour les appels machine-to-machine
SSO_API_KEY=""
SSO_API_SECRET=""

# Clé de signature des sessions JWT — générer avec : openssl rand -base64 32
# SESSION_SECRET est prioritaire. NEXTAUTH_SECRET est conservé comme fallback.
SESSION_SECRET=""
NEXTAUTH_SECRET=""
# NEXTAUTH_URL = URL publique du Guichet — sert aussi à construire la redirect_uri OAuth
# Doit correspondre exactement à la redirect_uri enregistrée dans l'admin SSO + "/auth/callback"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# CENTRES — Lot 7 Wave 6 (carte CJS + scanner staff)
# ─────────────────────────────────────────────────────────────
# Secret signature JWT QR carte CJS (HS256, TTL 15 min, ADR-002)
# openssl rand -hex 32
JWT_CJS_CARD_SECRET=""
# Whitelist emails conseillers staff autorisés au scanner (MVP, CSV)
# ex: "agent1@cjs.sn,agent2@cjs.sn"
CONSEILLER_STAFF_EMAILS=""
# Secret signature cookie session staff (HS256, TTL 12h)
# openssl rand -base64 32
STAFF_SESSION_SECRET=""

# ─────────────────────────────────────────────────────────────
# WHATSAPP — Meta Cloud API v19 (agent Aïssatou)
# ─────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# ─────────────────────────────────────────────────────────────
# IA — Groq
# ─────────────────────────────────────────────────────────────
GROQ_API_KEY=""

# ─────────────────────────────────────────────────────────────
# DATA HUB — Clé d'export
# Générer avec : openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
DATAHUB_API_KEY=""

# ─────────────────────────────────────────────────────────────
# INTERCONNEXION HMAC — Signatures inter-plateformes
# Demander les clés aux équipes de chaque plateforme
# ─────────────────────────────────────────────────────────────

# BRM
BRM_API_KEY=""
BRM_API_SECRET=""
BRM_BASE_URL="https://brm.cjs.sn"

# Gestion des Centres (MyDigitalPro)
CENTRES_API_KEY=""
CENTRES_API_SECRET=""
CENTRES_BASE_URL="https://centres.cjs.sn"

# Moodle — E-learning
MOODLE_API_KEY=""
MOODLE_API_SECRET=""
MOODLE_BASE_URL="https://elearning.cjs.sn"

# EduPop
EDUPOP_API_KEY=""
EDUPOP_API_SECRET=""
EDUPOP_BASE_URL="https://edupop.sn"

# ─────────────────────────────────────────────────────────────
# CARTE CJS — JWT QR rotatif (GUIC-386 / Wave 6.1)
# Secret HS256 32 bytes hex pour signer les tokens QR de check-in.
# Génère avec : openssl rand -hex 32
# Doit être configuré sur Vercel mouhammadouod (preview + prod).
# Fallback dev : random au boot avec warning logué.
# ─────────────────────────────────────────────────────────────
JWT_CJS_CARD_SECRET=""

# ─────────────────────────────────────────────────────────────
# CRON Vercel (auth Bearer pour /api/cron/*)
# Vercel injecte automatiquement CRON_SECRET côté serveur en prod.
# En dev/preview, définir manuellement : openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
CRON_SECRET=""

# ─────────────────────────────────────────────────────────────
# DIVERS
# ─────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
