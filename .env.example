# =============================================================
# GUIC-634 — VARIABLES LUES PAR LE CODE MAIS JAMAIS DOCUMENTÉES
# =============================================================
# Constat qui a motivé cette section : 25 des 59 variables lues par `src/` n'étaient
# documentées NULLE PART. Une variable non documentée est une variable qu'on oublie —
# et les oublis les plus coûteux sont SILENCIEUX : le service démarre, il a l'air sain,
# et une fonctionnalité entière est morte.
#
# Vérification : `scripts/deploy/preflight.sh` refuse le déploiement si les variables
# CRITIQUES manquent. Les autres sont marquées « optionnel » ci-dessous.

# ─────────────────────────────────────────────────────────────
# SÉCURITÉ — critiques, absence = panne ou faille
# ─────────────────────────────────────────────────────────────

# Signature des webhooks entrants du SSO (backchannel logout, user.updated,
# user.anonymized). SANS ELLE, la vérification de signature ne peut pas fonctionner.
# C'est le point d'entrée d'événements IRRÉVERSIBLES au sens CDP.
SSO_WEBHOOK_SECRET=""

# Signature des webhooks Meta WhatsApp. Le code est FAIL-CLOSED : sans cette variable,
# chaque webhook entrant est refusé, Meta retente, puis DÉSACTIVE l'abonnement.
# Tout le canal WhatsApp entrant meurt en silence. Vérifié par le préflight.
WHATSAPP_APP_SECRET=""

# ─────────────────────────────────────────────────────────────
# STOCKAGE OBJET
# ─────────────────────────────────────────────────────────────

# Pilote d'ÉCRITURE : `s3` en production OVH/MinIO, `vercel` sur le miroir de dev.
# La LECTURE reste polymorphe (les anciennes URL Vercel restent lisibles — GUIC-565).
STORAGE_DRIVER="s3"

# Endpoint S3. ⚠️ MinIO REJETTE tout nom d'hôte contenant un UNDERSCORE (HTTP 400,
# « invalid hostname » — GUIC-620). Si le conteneur s'appelle `minio_cjs`, poser un
# alias réseau : docker network connect --alias minio <réseau> <conteneur>
S3_ENDPOINT="http://minio:9000"

# Jeton Vercel Blob — nécessaire uniquement si STORAGE_DRIVER=vercel, ou pour relire
# les fichiers historiques déposés avant la bascule S3.
BLOB_READ_WRITE_TOKEN=""

# ─────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────

# Préfixe de TOUTES nos clés. Doit correspondre au périmètre accordé à notre utilisateur
# ACL côté serveur (`~guichet:*`). Si le lead attribue un autre préfixe, le changer ICI
# suffit — aucune modification de code. Un refus d'ACL est SILENCIEUX : rate-limiting et
# idempotence des webhooks meurent sans aucune alerte. Vérifié par le préflight.
REDIS_KEY_PREFIX="guichet:"

# ─────────────────────────────────────────────────────────────
# NOTIFICATIONS — ⚠️ DÉSACTIVÉES PAR DÉFAUT
# ─────────────────────────────────────────────────────────────

# Le code fait `if (NOTIFICATIONS_ENABLED !== 'true') return`. Autrement dit : sans cette
# variable à "true", AUCUNE notification ne part — et rien ne le signale.
NOTIFICATIONS_ENABLED="false"

# Canaux actifs, séparés par des virgules (ex. "web,whatsapp,email").
NOTIFICATION_CHANNELS="web"

# Webhook d'alerte pour les notifications abandonnées (DLQ). Optionnel : sans lui,
# l'abandon est seulement journalisé (`NOTIF_ABANDONED`).
ALERT_WEBHOOK_URL=""

# ─────────────────────────────────────────────────────────────
# SMS — Orange SMS Pro (Sénégal) · GUIC-552
# ─────────────────────────────────────────────────────────────
# Contrat identique à l'intégration SSO. key = HMAC-SHA1(token+subject+signature+recipient+content+timestamp, api_key).
# ⚠️ Valeurs réelles UNIQUEMENT dans .env.local (gitignoré) — jamais commit.
ORANGE_SMS_BASE_URL="https://api.orangesmspro.sn:8443/api"
ORANGE_SMS_LOGIN=""
ORANGE_SMS_API_KEY=""
ORANGE_SMS_TOKEN=""
ORANGE_SMS_SIGNATURE=""            # nom d'expéditeur SMS (≤ 11 car.)
ORANGE_SMS_SUBJECT="Guichet"       # libellé interne de campagne
ORANGE_SMS_VERIFY_SSL="false"      # endpoint Orange à certificat auto-signé

# ─────────────────────────────────────────────────────────────
# EMAIL — GCP / Gmail API · GUIC-553
# ─────────────────────────────────────────────────────────────
# Réutilise GOOGLE_APPLICATION_CREDENTIALS (service account, domain-wide delegation).
GCP_EMAIL_SENDER=""                 # adresse expéditrice Workspace (impersonation)

