# Modèle pour scripts/vercel-env-setup.sh — GUIC-625.
#
# COPIER CE FICHIER HORS DU DÉPÔT (ex. ~/.guichet.env), le remplir, puis :
#   chmod 600 ~/.guichet.env
#   VERCEL_ENV_FILE=~/.guichet.env bash scripts/vercel-env-setup.sh
#
# ⚠️ Ne JAMAIS remettre de valeur réelle dans ce fichier-ci : il est suivi par git.
# ⚠️ Les secrets ci-dessous ont fuité dans l'historique (commit 974ce3c, 2026-05-07) et
#    sont COMPROMIS. Ne réutiliser AUCUNE ancienne valeur — générer/roter avant de remplir.

# — Base de données (mot de passe roté)
DATABASE_URL=

# — Redis (nouveau mot de passe ; l'instance redislabs exposée était directement joignable)
REDIS_URL=

# — Signature des sessions. FUITE LA PLUS GRAVE : cette clé permet de forger la session de
#   n'importe qui, admin compris. Générer : openssl rand -base64 32
SESSION_SECRET=
NEXTAUTH_SECRET=

# — URLs publiques (pas des secrets, mais à garder cohérentes)
NEXTAUTH_URL=
NEXT_PUBLIC_APP_URL=

# — SSO CJS (identité de la plateforme — à faire régénérer côté SSO)
SSO_BASE_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_API_KEY=

NODE_ENV=production
